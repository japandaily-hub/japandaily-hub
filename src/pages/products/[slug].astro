---
import { getCollection } from 'astro:content';
import LangSwitch from '../../components/LangSwitch.astro';
import ForexTicker from '../../components/ForexTicker.astro';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map(p => ({
    params: { slug: p.id },
    props:  { product: p },
  }));
}

const { product } = Astro.props;
const d = product.data;

const title   = d.title;
const price   = d.price ?? 0;
const descEn  = d.description_en ?? d.description ?? 'A carefully curated Japanese product of exceptional quality.';
const descJa  = d.description_ja ?? d.description ?? '厳選された日本の逸品です。';
const image   = d.imageUrl ?? 'https://images.unsplash.com/photo-1528360983277-13d401cdc186?w=800&q=70';
const buyUrl  = d.amazonUrl ?? d.amazon_url ?? '#';
const category = d.category ?? 'Japan Select';

// 全商品（関連商品用）
const allProducts = await getCollection('products');
const related = allProducts.filter(p => p.id !== product.id).slice(0, 3);

// ベースURL
const base = import.meta.env.BASE_URL ?? '';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Japan Daily Hub</title>
    <meta name="description" content={descEn.slice(0, 155)} />
    <!-- OGP -->
    <meta property="og:title" content={`${title} | Japan Daily Hub`} />
    <meta property="og:description" content={descEn.slice(0, 155)} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={`https://japandaily-hub.github.io/japandaily-hub/products/${product.id}`} />
    <meta property="og:type" content="product" />
    <meta property="og:site_name" content="Japan Daily Hub" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Japan Daily Hub`} />
    <meta name="twitter:description" content={descEn.slice(0, 155)} />
    <meta name="twitter:image" content={image} />
    <!-- 構造化データ (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Product",
      "name": title,
      "description": descEn,
      "image": image,
      "offers": {
        "@type": "Offer",
        "price": price,
        "priceCurrency": "JPY",
        "availability": "https://schema.org/InStock",
        "url": buyUrl,
        "seller": { "@type": "Organization", "name": "Amazon Japan" }
      },
      "brand": { "@type": "Brand", "name": "Japan Daily Hub" }
    })} />
    <!-- Google Analytics 4 — replace G-XXXXXXXXXX with your Measurement ID -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX');
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@300;400&family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&display=swap" rel="stylesheet" />
    <style>
      :root { --ink:#12100e; --gold:#b8963e; --gold-l:#d4af5a; --washi:#f6f1e9; }
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        background: var(--washi);
        color: var(--ink);
        font-family: 'Noto Serif JP','Hiragino Mincho ProN', serif;
      }

      /* ── HEADER ── */
      header {
        position: sticky; top: 0; z-index: 100;
        background: rgba(246,241,233,.92);
        backdrop-filter: blur(14px);
        border-bottom: 1px solid rgba(184,150,62,.25);
      }
      .header-inner {
        max-width: 1200px; margin: 0 auto;
        padding: 0 1.5rem; height: 64px;
        display: flex; align-items: center; justify-content: space-between;
      }
      .site-name {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.3rem; font-weight: 300;
        letter-spacing: .22em; text-transform: uppercase;
        color: var(--ink); text-decoration: none;
      }
      .site-name em { color: var(--gold); font-style: normal; }

      /* ── BREADCRUMB ── */
      .breadcrumb {
        max-width: 1200px; margin: 0 auto;
        padding: 1rem 1.5rem;
        font-size: .65rem; letter-spacing: .18em;
        color: rgba(18,16,14,.4);
      }
      .breadcrumb a {
        color: rgba(18,16,14,.4); text-decoration: none;
        transition: color .2s;
      }
      .breadcrumb a:hover { color: var(--gold); }
      .breadcrumb span { margin: 0 .5rem; }

      /* ── PRODUCT LAYOUT ── */
      .product-wrap {
        max-width: 1200px; margin: 0 auto;
        padding: 2rem 1.5rem 6rem;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: start;
      }
      @media (max-width: 768px) {
        .product-wrap { grid-template-columns: 1fr; gap: 2rem; }
      }

      /* ── IMAGE ── */
      .product-image-wrap {
        position: sticky; top: 80px;
        background: #f0ece4;
        aspect-ratio: 1;
        display: flex; align-items: center; justify-content: center;
        overflow: hidden;
      }
      .product-image-wrap img {
        width: 100%; height: 100%;
        object-fit: contain; padding: 2rem;
        transition: transform .6s ease;
      }
      .product-image-wrap:hover img { transform: scale(1.04); }

      /* ── PRODUCT INFO ── */
      .product-info { display: flex; flex-direction: column; gap: 1.4rem; }

      .product-cat {
        font-size: .62rem; letter-spacing: .4em;
        color: var(--gold); text-transform: uppercase;
      }

      .product-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(1.6rem, 3vw, 2.4rem);
        font-weight: 300; letter-spacing: .06em;
        line-height: 1.3;
      }

      /* ── YEN ADVANTAGE ── */
      .yen-box {
        border: 1px solid rgba(74,222,128,.3);
        background: rgba(74,222,128,.05);
        padding: 1rem 1.2rem;
        display: flex; flex-direction: column; gap: .4rem;
      }
      .yen-box .yen-title {
        font-size: .6rem; letter-spacing: .3em;
        color: #16a34a; text-transform: uppercase;
      }
      .yen-box .yen-row {
        display: flex; align-items: baseline; gap: .8rem; flex-wrap: wrap;
      }
      .yen-box .price-now {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.5rem; color: var(--ink);
      }
      .yen-box .price-foreign {
        font-size: .85rem; color: #16a34a; letter-spacing: .05em;
      }
      .yen-box .price-was {
        font-size: .78rem; color: rgba(18,16,14,.35);
        text-decoration: line-through;
      }
      .yen-box .savings-label {
        font-size: .72rem; color: #16a34a; letter-spacing: .06em;
      }

      /* ── DESCRIPTION ── */
      .desc-label {
        font-size: .62rem; letter-spacing: .35em;
        color: rgba(18,16,14,.4); text-transform: uppercase;
        margin-bottom: .5rem;
      }
      .desc-text {
        font-size: .88rem; line-height: 2;
        letter-spacing: .04em; color: rgba(18,16,14,.8);
      }

      /* ── DIVIDER ── */
      .rule {
        height: 1px;
        background: rgba(184,150,62,.2);
      }

      /* ── BUY BUTTON ── */
      .btn-buy {
        display: block; text-align: center;
        padding: 1.1rem;
        background: var(--ink); color: #fff;
        text-decoration: none;
        font-size: .68rem; letter-spacing: .4em; text-transform: uppercase;
        transition: background .22s;
        border: none; cursor: pointer;
      }
      .btn-buy:hover { background: var(--gold); }

      /* ── WISHLIST BUTTON (detail) ── */
      .btn-wl-detail {
        display: block; width: 100%; text-align: center;
        padding: 1.1rem;
        background: transparent; color: var(--ink);
        border: 1px solid rgba(184,150,62,.5);
        font-size: .68rem; letter-spacing: .4em; text-transform: uppercase;
        cursor: pointer; font-family: inherit;
        transition: border-color .22s, background .22s;
        margin-top: .75rem;
      }
      .btn-wl-detail:hover { border-color: var(--gold); background: rgba(184,150,62,.06); }
      .btn-wl-detail.saved { color: #e63946; border-color: rgba(230,57,70,.4); }

      .btn-note {
        font-size: .62rem; letter-spacing: .12em;
        color: rgba(18,16,14,.35); text-align: center;
        margin-top: .6rem;
      }

      /* ── TAGS ── */
      .tags { display: flex; gap: .5rem; flex-wrap: wrap; }
      .tag {
        font-size: .58rem; letter-spacing: .2em;
        padding: .25rem .7rem;
        border: 1px solid rgba(184,150,62,.25);
        color: rgba(18,16,14,.45);
        text-transform: uppercase;
      }

      /* ── RELATED ── */
      .related-section {
        border-top: 1px solid rgba(184,150,62,.2);
        padding: 4rem 1.5rem;
        max-width: 1200px; margin: 0 auto;
      }
      .related-head {
        font-size: .68rem; letter-spacing: .45em;
        color: var(--gold); text-transform: uppercase;
        margin-bottom: 2rem;
      }
      .related-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 1.5rem;
      }
      .related-card {
        background: #fff;
        border: 1px solid rgba(184,150,62,.12);
        display: flex; flex-direction: column;
        text-decoration: none; color: inherit;
        transition: box-shadow .25s, transform .25s;
      }
      .related-card:hover {
        box-shadow: 0 8px 32px rgba(18,16,14,.08);
        transform: translateY(-3px);
      }
      .related-img {
        aspect-ratio: 4/3; overflow: hidden; background: #f0ece4;
      }
      .related-img img {
        width: 100%; height: 100%; object-fit: contain; padding: .8rem;
      }
      .related-body { padding: 1rem; }
      .related-name {
        font-size: .8rem; line-height: 1.7; letter-spacing: .04em;
        margin-bottom: .5rem;
      }
      .related-price {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.2rem; color: var(--ink);
      }

      /* ── FOOTER ── */
      footer {
        border-top: 1px solid rgba(184,150,62,.18);
        padding: 2rem 1.5rem; text-align: center;
        font-size: .62rem; letter-spacing: .3em;
        color: rgba(18,16,14,.3); text-transform: uppercase;
      }
    </style>
  </head>
  <body>

    <ForexTicker />

    <header>
      <div class="header-inner">
        <a href={`${base}/`} class="site-name">Japan<em>Daily</em> Hub</a>
        <LangSwitch />
      </div>
    </header>

    <!-- パンくずリスト -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={`${base}/`} data-en="Home" data-ja="ホーム">Home</a>
      <span aria-hidden="true">›</span>
      <span>{category}</span>
      <span aria-hidden="true">›</span>
      <span>{title}</span>
    </nav>

    <!-- 商品メインエリア -->
    <div class="product-wrap">

      <!-- 左: 画像 -->
      <div class="product-image-wrap">
        <img src={image} alt={title} />
      </div>

      <!-- 右: 情報 -->
      <div class="product-info">

        <div class="product-cat">{category}</div>

        <h1 class="product-title">{title}</h1>

        <!-- 円安メリットボックス -->
        <div class="yen-box">
          <div class="yen-title" data-en="Yen Advantage — Buy Now" data-ja="円安メリット — 今が買い時">Yen Advantage — Buy Now</div>
          <div class="yen-row">
            <div class="price-now">¥{price.toLocaleString()}</div>
            <div class="price-foreign" id="pd-foreign">≈ calculating…</div>
            <div class="price-was" id="pd-was"></div>
          </div>
          <div class="savings-label" id="pd-savings"></div>
        </div>

        <div class="rule"></div>

        <!-- 説明文 -->
        <div>
          <div class="desc-label" data-en="About this product" data-ja="商品について">About this product</div>
          <p class="desc-text" id="desc-en" data-en={descEn} data-ja={descJa}>{descEn}</p>
        </div>

        <!-- タグ -->
        {d.tags && d.tags.length > 0 && (
          <div class="tags">
            {d.tags.map(tag => <span class="tag">{tag}</span>)}
          </div>
        )}

        <div class="rule"></div>

        <!-- Dual CTA -->
        <a
          href={buyUrl}
          class="btn-buy"
          target="_blank"
          rel="noopener noreferrer"
          data-product-id={product.id}
          data-price={price}
          data-en="Buy on Amazon Japan ↗"
          data-ja="Amazon Japanで購入 ↗"
        >
          Buy on Amazon Japan ↗
        </a>
        <button
          id="detail-wl-btn"
          class="btn-wl-detail"
          data-id={product.id}
          data-title={title}
          data-price={price}
          data-img={image}
          data-en="♡  Add to Wishlist"
          data-ja="♡  ウィッシュリストへ"
        >
          ♡  Add to Wishlist
        </button>
        <p class="btn-note" data-en="Ships internationally · Fulfilled by Amazon" data-ja="国際配送対応 · Amazon発送">
          Ships internationally · Fulfilled by Amazon
        </p>

      </div>
    </div>

    <!-- 関連商品 -->
    {related.length > 0 && (
      <section class="related-section">
        <div class="related-head" data-en="You may also like" data-ja="関連商品">You may also like</div>
        <div class="related-grid">
          {related.map(r => (
            <a href={`${base}/products/${r.id}`} class="related-card">
              <div class="related-img">
                <img
                  src={r.data.imageUrl ?? 'https://images.unsplash.com/photo-1528360983277-13d401cdc186?w=400&q=60'}
                  alt={r.data.title}
                  loading="lazy"
                />
              </div>
              <div class="related-body">
                <div class="related-name">{r.data.title}</div>
                <div class="related-price">¥{(r.data.price ?? 0).toLocaleString()}</div>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <footer>
      &copy; 2025 Japan Daily Hub &nbsp;|&nbsp;
      <span data-en="Authentic Japanese Products, Delivered Worldwide" data-ja="日本の逸品、世界へ">
        Authentic Japanese Products, Delivered Worldwide
      </span>
    </footer>

    <script define:vars={{ price, descEn, descJa, productId: product.id, productTitle: title, productImg: image }}>
      // ── 為替API フォールバック3系統 ──
      const RATE_APIS = [
        'https://open.er-api.com/v6/latest/JPY',
        'https://api.exchangerate-api.com/v4/latest/JPY',
        'https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest/v1/currencies/jpy.json',
      ];

      async function fetchRates() {
        // sessionStorageキャッシュ (TTL: 10分)
        try {
          const cached = JSON.parse(sessionStorage.getItem('jdh-rates') || 'null');
          if (cached && Date.now() - cached.ts < 600_000) return cached;
        } catch {}

        for (const url of RATE_APIS) {
          try {
            const res = await fetch(url, { signal: AbortSignal.timeout(3500) });
            if (!res.ok) continue;
            const data = await res.json();
            // normalize: open.er-api returns data.rates.USD, fawazahmed returns data.jpy.usd
            const usd = data.rates?.USD ?? data.jpy?.usd;
            const gbp = data.rates?.GBP ?? data.jpy?.gbp;
            const eur = data.rates?.EUR ?? data.jpy?.eur;
            if (!usd) continue;
            const result = { usd: 1/usd, gbp: 1/gbp, eur: 1/eur, ts: Date.now() };
            sessionStorage.setItem('jdh-rates', JSON.stringify(result));
            return result;
          } catch {}
        }
        return { usd: 155, gbp: 196, eur: 168, ts: 0 }; // ultimate fallback
      }

      async function calcYenAdvantage() {
        const r = await fetchRates();
        const BASELINE_USD = 108;
        const amtNow  = price / r.usd;
        const amtWas  = price / BASELINE_USD;
        const saved   = amtWas - amtNow;
        const pct     = Math.round((saved / amtWas) * 100);
        const amtGbp  = price / r.gbp;

        document.getElementById('pd-foreign').textContent =
          `≈ $${amtNow.toFixed(2)} USD / £${amtGbp.toFixed(2)} GBP`;
        document.getElementById('pd-was').textContent =
          `was $${amtWas.toFixed(2)} in 2021`;
        document.getElementById('pd-savings').textContent =
          pct > 0 ? `You save ~$${saved.toFixed(2)} (${pct}%) thanks to the weak yen` : '';

        // Amazonリンクのクリック計測 (GA4)
        document.querySelectorAll('a[href*="amazon.co.jp"]').forEach(a => {
          a.addEventListener('click', () => {
            if (typeof gtag === 'function') {
              gtag('event', 'amazon_click', { product_id: a.dataset.productId, price: a.dataset.price });
            }
          });
        });
      }

      // ── 言語切替対応 ──
      const LANGS = ['en','ja'];
      function applyLang(lang) {
        if (!LANGS.includes(lang)) lang = 'en';
        document.querySelectorAll('[data-en]').forEach(el => {
          const t = el.dataset[lang] || el.dataset.en;
          if (t) el.innerHTML = t;
        });
      }
      const savedLang = (() => { try { return localStorage.getItem('jdh-lang'); } catch { return null; } })();
      if (savedLang) applyLang(savedLang);

      // ── Wishlist ──
      const WL_KEY = 'jdh-wishlist';
      const wlBtn  = document.getElementById('detail-wl-btn');

      function getWL() { try { return JSON.parse(localStorage.getItem(WL_KEY) || '[]'); } catch { return []; } }
      function saveWL(list) { try { localStorage.setItem(WL_KEY, JSON.stringify(list)); } catch {} }

      function syncWLBtn() {
        if (!wlBtn) return;
        const saved = getWL().some(i => i.id === wlBtn.dataset.id);
        wlBtn.classList.toggle('saved', saved);
        const lang = savedLang || 'en';
        wlBtn.textContent = saved
          ? (lang === 'ja' ? '♥  ウィッシュリスト済み' : '♥  In Wishlist')
          : (lang === 'ja' ? '♡  ウィッシュリストへ' : '♡  Add to Wishlist');
      }

      wlBtn?.addEventListener('click', () => {
        const { id, title: t, price: pr, img } = wlBtn.dataset;
        let list = getWL();
        const exists = list.some(i => i.id === id);
        saveWL(exists ? list.filter(i => i.id !== id) : [...list, { id, title: t, price: pr, img }]);
        syncWLBtn();
      });

      syncWLBtn();
      calcYenAdvantage();
    </script>
  </body>
</html>
