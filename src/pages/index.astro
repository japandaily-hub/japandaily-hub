---
import { categories } from '../data/categories.ts';
import CategoryIcon from '../components/CategoryIcon.astro';
const base = import.meta.env.BASE_URL ?? '';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Japan Daily Hub | Authentic Japanese Products</title>
  <meta name="description" content="Authentic Japanese products at Japanese market prices. Direct from Tokyo ‚Äî without the import markup. Ships worldwide." />
  <meta property="og:title" content="Japan Daily Hub | Authentic Japanese Products" />
  <meta property="og:description" content="Curated Japanese products at genuine local prices. The same items found in Tokyo ‚Äî delivered to your door." />
  <meta property="og:image" content="https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?w=1200&q=80" />
  <meta property="og:url" content="https://japandaily-hub.github.io/japandaily-hub/" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Japan Daily Hub" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Japan Daily Hub | Authentic Japanese Products" />
  <meta name="twitter:description" content="Authentic Japanese products at genuine local prices. Direct from Tokyo, without the import markup." />
  <meta name="twitter:image" content="https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?w=1200&q=80" />
  <link rel="canonical" href="https://japandaily-hub.github.io/japandaily-hub/" />
  <!-- Google Analytics 4 ‚Äî replace G-XXXXXXXXXX with your Measurement ID -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-XXXXXXXXXX');
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@300;400&family=Cormorant+Garamond:wght@300;400&display=swap" rel="stylesheet" />
  <style>
    :root {
      --ink: #12100e;
      --gold: #b8963e;
      --gold-l: #d4af5a;
      --washi: #f6f1e9;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--washi);
      color: var(--ink);
      font-family: 'Noto Serif JP', serif;
    }

    /* TICKER */
    .ticker {
      background: var(--ink);
      color: rgba(255,255,255,.6);
      font-size: .6rem;
      letter-spacing: .18em;
      padding: .4rem 1.5rem;
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .ticker-lbl { color: var(--gold); }
    .ticker-rate { color: #fff; }
    .ticker-save { color: #4ade80; margin-left: auto; }

    /* HEADER */
    header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(246,241,233,.95);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(184,150,62,.25);
    }
    .header-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .logo {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.3rem;
      font-weight: 300;
      letter-spacing: .22em;
      text-transform: uppercase;
      color: var(--ink);
    }
    .logo em { color: var(--gold); font-style: normal; }
    .lang-select {
      background: transparent;
      border: 1px solid rgba(184,150,62,.35);
      color: var(--ink);
      padding: .35rem .7rem;
      font-size: .72rem;
      font-family: inherit;
      cursor: pointer;
      border-radius: 2px;
      outline: none;
      letter-spacing: .05em;
    }
    .lang-select:hover { border-color: var(--gold); }

    /* HERO */
    .hero {
      background: var(--ink);
      color: #fff;
      text-align: center;
      padding: 6rem 1.5rem 5rem;
      position: relative;
      overflow: hidden;
    }
    .hero-bg {
      position: absolute; inset: 0;
      background: url('https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?w=1600&q=60') center/cover no-repeat;
      opacity: .15;
    }
    .hero-inner { position: relative; z-index: 1; }
    .hero-eye {
      font-size: .68rem;
      letter-spacing: .5em;
      color: var(--gold-l);
      text-transform: uppercase;
      margin-bottom: 1rem;
    }
    .hero-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(2rem, 5vw, 4rem);
      font-weight: 300;
      letter-spacing: .12em;
      line-height: 1.3;
    }
    .hero-line {
      width: 44px; height: 1px;
      background: var(--gold);
      margin: 1.8rem auto;
    }
    .hero-desc {
      font-size: .82rem;
      line-height: 2;
      color: rgba(255,255,255,.55);
      letter-spacing: .08em;
    }

    /* YEN SECTION */
    .yen-section {
      background: #1a1510;
      color: #fff;
      padding: 4rem 1.5rem;
      text-align: center;
    }
    .yen-eye {
      font-size: .65rem;
      letter-spacing: .45em;
      color: var(--gold-l);
      text-transform: uppercase;
      margin-bottom: .8rem;
    }
    .yen-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(1.6rem, 3.5vw, 2.8rem);
      font-weight: 300;
      letter-spacing: .1em;
      margin-bottom: 1.2rem;
    }
    .yen-body {
      max-width: 560px;
      margin: 0 auto 2.5rem;
      font-size: .88rem;
      line-height: 2;
      color: rgba(255,255,255,.5);
      letter-spacing: .04em;
    }
    .rate-cards {
      display: flex;
      justify-content: center;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 2.5rem;
    }
    .rate-card {
      border: 1px solid rgba(184,150,62,.25);
      border-radius: 4px;
      padding: 1.2rem 1.5rem;
      min-width: 130px;
      text-align: center;
    }
    .rate-flag { font-size: 1.6rem; margin-bottom: .3rem; }
    .rate-cur { font-size: .6rem; letter-spacing: .3em; color: rgba(255,255,255,.4); margin-bottom: .4rem; }
    .rate-val {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.7rem;
      color: #fff;
    }
    .rate-badge {
      font-size: .62rem;
      color: var(--gold-l);
      margin-top: .4rem;
      letter-spacing: .06em;
    }
    .calc-box {
      max-width: 520px;
      margin: 0 auto;
      border: 1px solid rgba(184,150,62,.25);
      border-radius: 4px;
      padding: 1.8rem;
      text-align: left;
    }
    .calc-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.2rem;
      font-weight: 300;
      letter-spacing: .1em;
      margin-bottom: 1rem;
    }
    .calc-row { display: flex; gap: .75rem; margin-bottom: 1.2rem; flex-wrap: wrap; }
    .calc-input {
      flex: 1;
      min-width: 120px;
  #   background: rgba(255,255,255,.06);
      border: 1px solid rgba(184,150,62,.3);
      color: #fff;
      padding: .6rem .8rem;
      font-size: .9rem;
      font-family: 'Cormorant Garamond', serif;
      outline: none;
      border-radius: 2px;
    }
    .calc-select {
      background: rgba(255,255,255,.06);
      border: 1px solid rgba(184,150,62,.3);
      color: #fff;
      padding: .6rem .8rem;
      font-size: .85rem;
      outline: none;
      cursor: pointer;
      border-radius: 2px;
    }
    .calc-result {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .calc-col { flex: 1; min-width: 100px; }
    .calc-col-lbl { font-size: .58rem; letter-spacing: .2em; color: rgba(255,255,255,.35); text-transform: uppercase; margin-bottom: .3rem; }
    .calc-now { font-family: 'Cormorant Garamond', serif; font-size: 1.5rem; }
    .calc-was { font-family: 'Cormorant Garamond', serif; font-size: 1.3rem; color: rgba(255,255,255,.35); text-decoration: line-through; }
    .calc-save { font-family: 'Cormorant Garamond', serif; font-size: 1.8rem; color: #4ade80; }
    .calc-save-pct { font-size: .7rem; color: rgba(74,222,128,.7); letter-spacing: .1em; }

    /* TABS */
    .tab-nav {
      background: rgba(246,241,233,.98);
      border-bottom: 1px solid rgba(184,150,62,.2);
      position: sticky;
      top: 64px;
      z-index: 90;
    }
    .tab-list {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
      display: flex;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .tab-list::-webkit-scrollbar { display: none; }
    .tab-btn {
      flex-shrink: 0;
      padding: .85rem 1.5rem;
      font-size: .72rem;
      letter-spacing: .2em;
      color: rgba(18,16,14,.45);
      border: none;
      background: none;
      cursor: pointer;
      border-bottom: 2px solid transparent;
      transition: color .2s, border-color .2s;
      font-family: inherit;
      white-space: nowrap;
    }
    .tab-btn:hover { color: var(--ink); }
    .tab-btn.active { color: var(--gold); border-bottom-color: var(--gold); }

    /* PRODUCTS */
    .section-wrap {
      max-width: 1200px;
      margin: 0 auto;
      padding: 4rem 1.5rem 5rem;
    }
    .section-head {
      display: flex;
      align-items: center;
      gap: 1.2rem;
      margin-bottom: 2.5rem;
    }
    .section-lbl {
      font-size: .68rem;
      letter-spacing: .45em;
      color: var(--gold);
      text-transform: uppercase;
      white-space: nowrap;
    }
    .section-rule {
      flex: 1;
      height: 1px;
      background: linear-gradient(to right, rgba(184,150,62,.4), transparent);
    }
    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 1.8rem;
    }
    .product-card {
      background: #fff;
      border: 1px solid rgba(184,150,62,.12);
      display: flex;
      flex-direction: column;
      transition: box-shadow .3s, transform .3s;
    }
    .product-card:hover {
      box-shadow: 0 16px 48px rgba(18,16,14,.1);
      transform: translateY(-4px);
    }
    .product-img-wrap {
      aspect-ratio: 4/3;
      overflow: hidden;
      background: #f0ece4;
      display: block;
      text-decoration: none;
    }
    .product-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      padding: 1rem;
      transition: transform .5s ease;
    }
    .product-card:hover .product-img-wrap img { transform: scale(1.05); }
    .product-body {
      padding: 1.3rem;
      display: flex;
      flex-direction: column;
      flex: 1;
    }
    .product-cat {
      font-size: .58rem;
      letter-spacing: .35em;
      color: var(--gold);
      text-transform: uppercase;
      margin-bottom: .5rem;
    }
    .product-name {
      font-size: .85rem;
      line-height: 1.8;
      color: var(--ink);
      flex: 1;
      margin-bottom: .8rem;
      text-decoration: none;
    }
    .yen-badge {
      font-size: .58rem;
      padding: .2rem .6rem;
      background: rgba(74,222,128,.1);
      color: #16a34a;
      border: 1px solid rgba(74,222,128,.3);
      display: inline-block;
      margin-bottom: .8rem;
      letter-spacing: .06em;
    }
    .product-price {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.55rem;
      color: var(--ink);
      margin-bottom: 1rem;
    }
    .product-price small { font-size: .85rem; color: rgba(18,16,14,.5); }
    .btn-buy {
      display: block;
      text-align: center;
      padding: .8rem;
      background: var(--ink);
      color: #fff;
      text-decoration: none;
      font-size: .62rem;
      letter-spacing: .38em;
      text-transform: uppercase;
      transition: background .22s;
    }
    .btn-buy:hover { background: var(--gold); }

    /* PANEL */
    .tab-panel { display: none; }
    .tab-panel.active { display: block; }

    /* WISHLIST BUTTON (header) */
    .wl-header-btn {
      background: none; border: 1px solid rgba(184,150,62,.35);
      color: var(--ink); padding: .3rem .75rem;
      font-size: .7rem; letter-spacing: .1em;
      cursor: pointer; border-radius: 2px;
      display: flex; align-items: center; gap: .4rem;
      font-family: inherit; transition: border-color .2s;
    }
    .wl-header-btn:hover { border-color: var(--gold); }
    .wl-count {
      background: var(--gold); color: #fff;
      font-size: .6rem; border-radius: 50%;
      width: 16px; height: 16px;
      display: none; align-items: center; justify-content: center;
    }
    .wl-count.visible { display: flex; }

    /* WISHLIST HEART on card */
    .wl-btn {
      position: absolute; top: .6rem; right: .6rem;
      background: rgba(255,255,255,.85); border: none;
      width: 32px; height: 32px; border-radius: 50%;
      font-size: 1rem; cursor: pointer; line-height: 1;
      transition: background .2s, transform .2s;
    }
    .wl-btn:hover { background: #fff; transform: scale(1.15); }
    .wl-btn.saved { color: #e63946; }

    /* DRAWER */
    .drawer-overlay {
      position: fixed; inset: 0; background: rgba(0,0,0,.4);
      z-index: 200; opacity: 0; pointer-events: none;
      transition: opacity .3s;
    }
    .drawer-overlay.open { opacity: 1; pointer-events: all; }
    .drawer {
      position: fixed; top: 0; right: 0; bottom: 0;
      width: min(380px, 92vw);
      background: var(--washi);
      z-index: 201;
      transform: translateX(100%);
      transition: transform .35s cubic-bezier(.4,0,.2,1);
      display: flex; flex-direction: column;
      box-shadow: -8px 0 32px rgba(0,0,0,.12);
    }
    .drawer.open { transform: translateX(0); }
    .drawer-head {
      padding: 1.2rem 1.5rem;
      border-bottom: 1px solid rgba(184,150,62,.2);
      display: flex; align-items: center; justify-content: space-between;
    }
    .drawer-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.2rem; font-weight: 300; letter-spacing: .1em;
    }
    .drawer-close {
      background: none; border: none; font-size: 1.4rem;
      cursor: pointer; color: rgba(18,16,14,.4);
      padding: 0 .3rem; line-height: 1;
    }
    .drawer-body { flex: 1; overflow-y: auto; padding: 1rem 1.5rem; }
    .wl-empty {
      text-align: center; padding: 3rem 0;
      color: rgba(18,16,14,.3); font-size: .85rem; letter-spacing: .1em;
    }
    .wl-item {
      display: flex; gap: 1rem; align-items: center;
      padding: .9rem 0; border-bottom: 1px solid rgba(184,150,62,.12);
    }
    .wl-item-img {
      width: 60px; height: 60px; object-fit: contain;
      background: #f0ece4; padding: .3rem; flex-shrink: 0;
    }
    .wl-item-info { flex: 1; }
    .wl-item-name { font-size: .8rem; line-height: 1.5; margin-bottom: .3rem; }
    .wl-item-price {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.1rem; color: var(--ink);
    }
    .wl-item-remove {
      background: none; border: none; color: rgba(18,16,14,.3);
      font-size: 1.1rem; cursor: pointer; padding: 0 .3rem;
    }
    .wl-item-remove:hover { color: #e63946; }
    .drawer-footer { padding: 1rem 1.5rem; border-top: 1px solid rgba(184,150,62,.2); }
    .btn-wl-clear {
      width: 100%; padding: .75rem; border: 1px solid rgba(184,150,62,.3);
      background: none; color: rgba(18,16,14,.45); font-family: inherit;
      font-size: .65rem; letter-spacing: .25em; cursor: pointer;
      text-transform: uppercase; transition: all .2s;
    }
    .btn-wl-clear:hover { border-color: var(--gold); color: var(--ink); }

    /* EMAIL SECTION */
    .email-section {
      background: var(--ink); color: #fff;
      padding: 4rem 1.5rem; text-align: center;
    }
    .email-eye {
      font-size: .62rem; letter-spacing: .45em;
      color: var(--gold-l); text-transform: uppercase;
      margin-bottom: .8rem;
    }
    .email-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(1.4rem, 3vw, 2.2rem);
      font-weight: 300; letter-spacing: .1em; margin-bottom: .8rem;
    }
    .email-desc {
      font-size: .8rem; color: rgba(255,255,255,.45);
      letter-spacing: .06em; margin-bottom: 2rem; line-height: 1.8;
    }
    .email-form {
      display: flex; gap: .75rem; justify-content: center;
      flex-wrap: wrap; max-width: 480px; margin: 0 auto;
    }
    .email-input {
      flex: 1; min-width: 220px;
      background: rgba(255,255,255,.07);
      border: 1px solid rgba(184,150,62,.3);
      color: #fff; padding: .75rem 1rem;
      font-size: .85rem; font-family: inherit;
      outline: none; border-radius: 2px;
    }
    .email-input::placeholder { color: rgba(255,255,255,.25); }
    .email-input:focus { border-color: var(--gold-l); }
    .btn-email {
      padding: .75rem 1.6rem;
      background: var(--gold); color: #fff; border: none;
      font-size: .65rem; letter-spacing: .3em; text-transform: uppercase;
      cursor: pointer; font-family: inherit; border-radius: 2px;
      transition: background .2s; white-space: nowrap;
    }
    .btn-email:hover { background: var(--gold-l); }
    .email-success {
      display: none; color: #4ade80;
      font-size: .8rem; letter-spacing: .1em; margin-top: 1rem;
    }

    /* CATEGORY GRID */
    .cat-section {
      background: var(--washi);
      padding: 4rem 1.5rem 5rem;
    }
    .cat-inner {
      max-width: 1200px;
      margin: 0 auto;
    }
    .cat-eye {
      font-size: .65rem;
      letter-spacing: .45em;
      color: var(--gold);
      text-transform: uppercase;
      text-align: center;
      margin-bottom: .6rem;
    }
    .cat-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(1.4rem, 3vw, 2.2rem);
      font-weight: 300;
      letter-spacing: .1em;
      text-align: center;
      margin-bottom: 2.5rem;
      color: var(--ink);
    }
    .cat-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 1rem;
    }
    .cat-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: .6rem;
      padding: 1.6rem 1rem;
      border: 1px solid rgba(184,150,62,.18);
      background: #fff;
      text-decoration: none;
      color: var(--ink);
      transition: box-shadow .25s, transform .25s, border-color .25s;
      border-radius: 2px;
    }
    .cat-card:hover {
      box-shadow: 0 8px 28px rgba(18,16,14,.09);
      transform: translateY(-3px);
      border-color: rgba(184,150,62,.45);
    }
    .cat-icon {
      width: 2.4rem;
      height: 2.4rem;
      display: flex;
      align-items: center;
      justify-content: center;
      color: rgba(18,16,14,.5);
      transition: color .25s ease;
    }
    .cat-card:hover .cat-icon { color: var(--gold); }
    .cat-name {
      font-size: .78rem;
      font-weight: 500;
      letter-spacing: .06em;
      text-align: center;
      color: var(--ink);
    }
    .cat-desc {
      font-size: .62rem;
      color: rgba(18,16,14,.4);
      letter-spacing: .04em;
      text-align: center;
      line-height: 1.5;
    }
    .cat-arrow {
      font-size: .65rem;
      color: var(--gold);
      letter-spacing: .1em;
      margin-top: .2rem;
    }

    /* FOOTER */
    footer {
      border-top: 1px solid rgba(184,150,62,.18);
      padding: 2.2rem 1.5rem;
      text-align: center;
      font-size: .62rem;
      letter-spacing: .35em;
      color: rgba(18,16,14,.3);
      text-transform: uppercase;
    }
  </style>
</head>
<body>

  <!-- FOREX TICKER -->
  <div class="ticker">
    <span class="ticker-lbl">LIVE RATE</span>
    <span>USD <span class="ticker-rate" id="t-usd">‚Ä¶</span></span>
    <span>EUR <span class="ticker-rate" id="t-eur">‚Ä¶</span></span>
    <span>GBP <span class="ticker-rate" id="t-gbp">‚Ä¶</span></span>
    <span>AUD <span class="ticker-rate" id="t-aud">‚Ä¶</span></span>
    <span class="ticker-save" id="t-save">Live JPY Rate</span>
  </div>

  <!-- HEADER -->
  <header>
    <div class="header-inner">
      <div class="logo">Japan<em>Daily</em> Hub</div>
      <div style="display:flex;gap:1.5rem;align-items:center;">
        <a href="/japandaily-hub/about/" style="font-size:.62rem;letter-spacing:.22em;text-transform:uppercase;color:rgba(18,16,14,.5);text-decoration:none;transition:color .2s;" onmouseover="this.style.color='#b8963e'" onmouseout="this.style.color='rgba(18,16,14,.5)'">About</a>
        <button class="wl-header-btn" id="wl-open-btn" aria-label="Wishlist">
          ‚ô° <span class="wl-count" id="wl-count">0</span>
        </button>
        <select class="lang-select" id="lang-select">
        <option value="en">üåê English</option>
        <option value="ja">üáØüáµ Êó•Êú¨Ë™û</option>
        <option value="zh">üá®üá≥ ÁÆÄ‰Ωì‰∏≠Êñá</option>
