---
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Japan Daily Hub | Authentic Japanese Products</title>
  <meta name="description" content="Authentic Japanese products at Japanese market prices. Direct from Tokyo — without the import markup. Ships worldwide." />
  <meta property="og:title" content="Japan Daily Hub | Authentic Japanese Products" />
  <meta property="og:description" content="Curated Japanese products at genuine local prices. The same items found in Tokyo — delivered to your door." />
  <meta property="og:image" content="https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?w=1200&q=80" />
  <meta property="og:url" content="https://japandaily-hub.github.io/japandaily-hub/" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Japan Daily Hub" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Japan Daily Hub | Authentic Japanese Products" />
  <meta name="twitter:description" content="Authentic Japanese products at genuine local prices. Direct from Tokyo, without the import markup." />
  <meta name="twitter:image" content="https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?w=1200&q=80" />
  <link rel="canonical" href="https://japandaily-hub.github.io/japandaily-hub/" />
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-XXXXXXXXXX');
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@300;400&family=Cormorant+Garamond:wght@300;400&display=swap" rel="stylesheet" />
  <style>
    :root {
      --ink: #12100e;
      --ink-60: rgba(18,16,14,.6);
      --ink-40: rgba(18,16,14,.4);
      --ink-12: rgba(18,16,14,.12);
      --gold: #b8963e;
      --gold-l: #d4af5a;
      --gold-subtle: rgba(184,150,62,.15);
      --washi: #f6f1e9;
      --washi-dark: #ede7da;
      --radius: 3px;
      --shadow-sm: 0 4px 16px rgba(18,16,14,.07);
      --shadow-md: 0 12px 40px rgba(18,16,14,.12);
      --transition: .25s ease;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--washi);
      color: var(--ink);
      font-family: 'Noto Serif JP', serif;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    /* ── ANNOUNCEMENT BAR ── */
    .announce-bar {
      background: var(--ink);
      color: rgba(255,255,255,.82);
      font-size: .62rem;
      letter-spacing: .24em;
      text-transform: uppercase;
      text-align: center;
      padding: .52rem 1rem;
      line-height: 1.5;
    }
    .announce-bar em { color: var(--gold-l); font-style: normal; }

    /* ── HEADER ── */
    header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(246,241,233,.97);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba(184,150,62,.22);
      box-shadow: 0 2px 12px rgba(18,16,14,.04);
    }
    .header-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
      height: 68px;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 1rem;
    }
    .logo {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.35rem;
      font-weight: 300;
      letter-spacing: .25em;
      text-transform: uppercase;
      color: var(--ink);
      white-space: nowrap;
    }
    .logo em { color: var(--gold); font-style: normal; }

    /* Category nav — center column */
    .cat-nav {
      display: flex;
      align-items: center;
      gap: .1rem;
    }
    .cat-tab {
      background: none;
      border: none;
      padding: .35rem .75rem;
      font-family: 'Noto Serif JP', serif;
      font-size: .63rem;
      letter-spacing: .18em;
      text-transform: uppercase;
      color: var(--ink-60);
      cursor: pointer;
      border-radius: 2px;
      transition: color var(--transition), background var(--transition);
      white-space: nowrap;
    }
    .cat-tab:hover { color: var(--ink); background: var(--gold-subtle); }
    .cat-tab.active { color: var(--gold); border-bottom: 1.5px solid var(--gold); }

    /* Header utilities — right column */
    .header-utils {
      display: flex;
      align-items: center;
      gap: 1rem;
      justify-content: flex-end;
    }
    .header-about {
      font-size: .62rem;
      letter-spacing: .22em;
      text-transform: uppercase;
      color: rgba(18,16,14,.5);
      text-decoration: none;
      transition: color .2s;
    }
    .header-about:hover { color: var(--gold); }
    .lang-select {
      background: transparent;
      border: 1px solid rgba(184,150,62,.38);
      color: var(--ink);
      padding: .4rem .75rem;
      font-size: .72rem;
      font-family: inherit;
      cursor: pointer;
      border-radius: var(--radius);
      outline: none;
      letter-spacing: .05em;
      transition: border-color var(--transition);
    }
    .lang-select:hover, .lang-select:focus { border-color: var(--gold); }

    /* ── WISHLIST BUTTON ── */
    .wl-header-btn {
      background: none; border: 1px solid rgba(184,150,62,.35);
      color: var(--ink); padding: .3rem .75rem;
      font-size: .7rem; letter-spacing: .1em;
      cursor: pointer; border-radius: 2px;
      display: flex; align-items: center; gap: .4rem;
      font-family: inherit; transition: border-color .2s;
    }
    .wl-header-btn:hover { border-color: var(--gold); }
    .wl-count {
      background: var(--gold); color: #fff;
      font-size: .6rem; border-radius: 50%;
      width: 16px; height: 16px;
      display: none; align-items: center; justify-content: center;
    }
    .wl-count.visible { display: flex; }

    /* ── HERO ── */
    .hero {
      background: var(--ink);
      color: #fff;
      text-align: center;
      padding: 7rem 1.5rem 6rem;
      position: relative;
      overflow: hidden;
    }
    .hero-bg {
      position: absolute; inset: 0;
      background: url('https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?w=1600&q=60') center/cover no-repeat;
      opacity: .12;
    }
    .hero-inner { position: relative; z-index: 1; max-width: 720px; margin: 0 auto; }
    .hero-eye {
      font-size: .65rem;
      letter-spacing: .55em;
      color: var(--gold-l);
      text-transform: uppercase;
      margin-bottom: 1.2rem;
    }
    .hero-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(2.2rem, 5vw, 4.2rem);
      font-weight: 300;
      letter-spacing: .1em;
      line-height: 1.25;
    }
    .hero-line {
      width: 48px; height: 1px;
      background: var(--gold);
      margin: 2rem auto;
    }
    .hero-desc {
      font-size: .85rem;
      line-height: 2.1;
      color: rgba(255,255,255,.52);
      letter-spacing: .07em;
      margin-bottom: 2.5rem;
    }

    /* ── TRUST STRIP ── */
    .trust-strip {
      background: var(--washi-dark);
      border-bottom: 1px solid rgba(184,150,62,.18);
    }
    .trust-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
    }
    .trust-item {
      display: flex;
      align-items: center;
      gap: .9rem;
      padding: 1.4rem 1.5rem;
      border-right: 1px solid rgba(184,150,62,.18);
    }
    .trust-item:last-child { border-right: none; }
    .trust-icon { font-size: 1.4rem; flex-shrink: 0; }
    .trust-label {
      font-size: .68rem;
      letter-spacing: .15em;
      text-transform: uppercase;
      color: var(--ink);
      font-weight: 400;
      line-height: 1.5;
    }
    .trust-sub {
      font-size: .62rem;
      color: var(--ink-60);
      letter-spacing: .06em;
      margin-top: .15rem;
    }

    /* ── PRODUCTS SECTION ── */
    .products-section {
      max-width: 1200px;
      margin: 0 auto;
      padding: 4rem 1.5rem 5rem;
    }
    .section-head {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      margin-bottom: 2.5rem;
      border-bottom: 1px solid rgba(184,150,62,.18);
      padding-bottom: 1rem;
    }
    .section-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(1.5rem, 3vw, 2rem);
      font-weight: 300;
      letter-spacing: .12em;
    }
    .section-eye {
      font-size: .6rem;
      letter-spacing: .4em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: .4rem;
    }
    .view-all-link {
      font-size: .62rem;
      letter-spacing: .2em;
      text-transform: uppercase;
      color: var(--gold);
      text-decoration: none;
      border-bottom: 1px solid rgba(184,150,62,.35);
      padding-bottom: 2px;
      transition: border-color .2s;
      white-space: nowrap;
    }
    .view-all-link:hover { border-color: var(--gold); }

    /* Product grid */
    .product-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
    .product-card {
      background: #fff;
      border-radius: 4px;
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      transition: box-shadow var(--transition), transform var(--transition);
      position: relative;
    }
    .product-card:hover {
      box-shadow: var(--shadow-md);
      transform: translateY(-3px);
    }
    .product-card.hidden { display: none; }

    .product-badge {
      position: absolute;
      top: .7rem; left: .7rem;
      background: var(--gold);
      color: #fff;
      font-size: .55rem;
      letter-spacing: .15em;
      text-transform: uppercase;
      padding: .22rem .55rem;
      border-radius: 2px;
      z-index: 2;
    }
    .product-badge.sale { background: #c0392b; }

    .product-img-wrap {
      aspect-ratio: 1 / 1;
      overflow: hidden;
      background: var(--washi-dark);
    }
    .product-img {
      width: 100%; height: 100%;
      object-fit: cover;
      transition: transform .5s ease;
    }
    .product-card:hover .product-img { transform: scale(1.04); }

    .product-body { padding: 1rem 1rem .8rem; flex: 1; display: flex; flex-direction: column; }
    .product-cat {
      font-size: .55rem;
      letter-spacing: .25em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: .4rem;
    }
    .product-name {
      font-size: .82rem;
      line-height: 1.55;
      color: var(--ink);
      margin-bottom: .6rem;
      flex: 1;
    }
    .product-rating {
      display: flex;
      align-items: center;
      gap: .4rem;
      margin-bottom: .6rem;
    }
    .stars { color: var(--gold); font-size: .72rem; letter-spacing: -.05em; }
    .rating-count { font-size: .6rem; color: var(--ink-60); }
    .product-price-row {
      display: flex;
      align-items: baseline;
      gap: .5rem;
      margin-bottom: .9rem;
      flex-wrap: wrap;
    }
    .product-price {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.25rem;
      color: var(--ink);
      letter-spacing: .02em;
    }
    .product-price-orig {
      font-size: .75rem;
      color: var(--ink-40);
      text-decoration: line-through;
    }
    .product-save {
      font-size: .58rem;
      background: rgba(192,57,43,.1);
      color: #c0392b;
      padding: .12rem .35rem;
      border-radius: 2px;
      letter-spacing: .05em;
    }

    .product-actions {
      display: flex;
      gap: .5rem;
    }
    .btn-amazon {
      flex: 1;
      padding: .6rem .5rem;
      background: var(--ink);
      color: #fff;
      border: none;
      font-size: .58rem;
      letter-spacing: .2em;
      text-transform: uppercase;
      cursor: pointer;
      font-family: inherit;
      border-radius: 2px;
      text-align: center;
      text-decoration: none;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background var(--transition);
    }
    .btn-amazon:hover { background: var(--gold); }
    .btn-wl {
      width: 36px;
      flex-shrink: 0;
      background: none;
      border: 1px solid rgba(184,150,62,.35);
      color: var(--ink-60);
      font-size: .95rem;
      cursor: pointer;
      border-radius: 2px;
      transition: border-color .2s, color .2s, background .2s;
      display: flex; align-items: center; justify-content: center;
    }
    .btn-wl:hover, .btn-wl.active { border-color: var(--gold); color: var(--gold); background: var(--gold-subtle); }

    /* ── SERVICE TILES ── */
    .service-section {
      background: var(--ink);
      color: #fff;
    }
    .service-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
    }
    .service-tile {
      padding: 2.5rem 2rem;
      border-right: 1px solid rgba(255,255,255,.08);
      text-align: center;
    }
    .service-tile:last-child { border-right: none; }
    .service-icon { font-size: 1.8rem; margin-bottom: .9rem; }
    .service-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.1rem;
      font-weight: 300;
      letter-spacing: .18em;
      margin-bottom: .5rem;
    }
    .service-desc {
      font-size: .7rem;
      color: rgba(255,255,255,.45);
      line-height: 1.9;
      letter-spacing: .05em;
    }

    /* ── SPOTLIGHT SECTION ── */
    .spotlight-section {
      max-width: 1200px;
      margin: 0 auto;
      padding: 4.5rem 1.5rem;
    }
    .spotlight-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      align-items: center;
    }
    .spotlight-img-wrap {
      aspect-ratio: 4/3;
      overflow: hidden;
      border-radius: 4px;
    }
    .spotlight-img {
      width: 100%; height: 100%;
      object-fit: cover;
      transition: transform .6s ease;
    }
    .spotlight-img-wrap:hover .spotlight-img { transform: scale(1.04); }
    .spotlight-body { padding: 1rem 1.5rem; }
    .spotlight-eye {
      font-size: .6rem;
      letter-spacing: .42em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: .7rem;
    }
    .spotlight-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(1.6rem, 3vw, 2.4rem);
      font-weight: 300;
      letter-spacing: .1em;
      margin-bottom: 1rem;
      line-height: 1.3;
    }
    .spotlight-line {
      width: 36px; height: 1px;
      background: var(--gold);
      margin-bottom: 1.2rem;
    }
    .spotlight-desc {
      font-size: .82rem;
      line-height: 2;
      color: var(--ink-60);
      letter-spacing: .04em;
      margin-bottom: 1.8rem;
    }
    .btn-spotlight {
      display: inline-block;
      padding: .75rem 2rem;
      border: 1px solid var(--gold);
      color: var(--ink);
      font-size: .62rem;
      letter-spacing: .32em;
      text-transform: uppercase;
      text-decoration: none;
      font-family: inherit;
      border-radius: 2px;
      transition: background var(--transition), color var(--transition);
      cursor: pointer;
      background: none;
    }
    .btn-spotlight:hover { background: var(--gold); color: #fff; }

    /* ── DRAWER ── */
    .drawer-overlay {
      position: fixed; inset: 0; background: rgba(0,0,0,.4);
      z-index: 200; opacity: 0; pointer-events: none;
      transition: opacity .3s;
    }
    .drawer-overlay.open { opacity: 1; pointer-events: all; }
    .drawer {
      position: fixed; top: 0; right: 0; bottom: 0;
      width: min(380px, 92vw);
      background: var(--washi);
      z-index: 201;
      transform: translateX(100%);
      transition: transform .35s cubic-bezier(.4,0,.2,1);
      display: flex; flex-direction: column;
      box-shadow: -8px 0 32px rgba(0,0,0,.12);
    }
    .drawer.open { transform: translateX(0); }
    .drawer-head {
      padding: 1.2rem 1.5rem;
      border-bottom: 1px solid rgba(184,150,62,.2);
      display: flex; align-items: center; justify-content: space-between;
    }
    .drawer-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.2rem; font-weight: 300; letter-spacing: .1em;
    }
    .drawer-close {
      background: none; border: none; font-size: 1.4rem;
      cursor: pointer; color: rgba(18,16,14,.4);
      padding: 0 .3rem; line-height: 1;
    }
    .drawer-body { flex: 1; overflow-y: auto; padding: 1rem 1.5rem; }
    .wl-empty {
      text-align: center; padding: 3rem 0;
      color: rgba(18,16,14,.3); font-size: .85rem; letter-spacing: .1em;
    }
    .wl-item {
      display: flex; gap: 1rem; align-items: center;
      padding: .9rem 0; border-bottom: 1px solid rgba(184,150,62,.12);
    }
    .wl-item-img {
      width: 60px; height: 60px; object-fit: contain;
      background: #f0ece4; padding: .3rem; flex-shrink: 0;
    }
    .wl-item-info { flex: 1; }
    .wl-item-name { font-size: .8rem; line-height: 1.5; margin-bottom: .3rem; }
    .wl-item-price {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.1rem; color: var(--ink);
    }
    .wl-item-remove {
      background: none; border: none; color: rgba(18,16,14,.3);
      font-size: 1.1rem; cursor: pointer; padding: 0 .3rem;
    }
    .wl-item-remove:hover { color: #e63946; }
    .drawer-footer { padding: 1rem 1.5rem; border-top: 1px solid rgba(184,150,62,.2); }
    .btn-wl-clear {
      width: 100%; padding: .75rem; border: 1px solid rgba(184,150,62,.3);
      background: none; color: rgba(18,16,14,.45); font-family: inherit;
      font-size: .65rem; letter-spacing: .25em; cursor: pointer;
      text-transform: uppercase; transition: all .2s;
    }
    .btn-wl-clear:hover { border-color: var(--gold); color: var(--ink); }

    /* ── EMAIL SECTION ── */
    .email-section {
      background: var(--ink);
      color: #fff;
      padding: 5.5rem 1.5rem;
      text-align: center;
    }
    .email-eye {
      font-size: .62rem;
      letter-spacing: .48em;
      color: var(--gold-l);
      text-transform: uppercase;
      margin-bottom: .9rem;
    }
    .email-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(1.6rem, 3vw, 2.4rem);
      font-weight: 300;
      letter-spacing: .1em;
      margin-bottom: 1rem;
    }
    .email-desc {
      font-size: .82rem;
      color: rgba(255,255,255,.42);
      letter-spacing: .05em;
      margin-bottom: 2.5rem;
      line-height: 2;
      max-width: 480px;
      margin-left: auto;
      margin-right: auto;
    }
    .email-form {
      display: flex;
      gap: .75rem;
      justify-content: center;
      flex-wrap: wrap;
      max-width: 520px;
      margin: 0 auto 1.5rem;
    }
    .email-input {
      flex: 1;
      min-width: 220px;
      background: rgba(255,255,255,.08);
      border: 1px solid rgba(184,150,62,.32);
      color: #fff;
      padding: .9rem 1.1rem;
      font-size: .85rem;
      font-family: inherit;
      outline: none;
      border-radius: var(--radius);
      transition: border-color var(--transition);
    }
    .email-input::placeholder { color: rgba(255,255,255,.22); }
    .email-input:focus { border-color: var(--gold-l); background: rgba(255,255,255,.11); }
    .btn-email {
      padding: .9rem 2rem;
      background: var(--gold);
      color: #fff;
      border: none;
      font-size: .65rem;
      letter-spacing: .35em;
      text-transform: uppercase;
      cursor: pointer;
      font-family: inherit;
      border-radius: var(--radius);
      transition: background var(--transition), box-shadow var(--transition), transform var(--transition);
      white-space: nowrap;
      box-shadow: 0 4px 20px rgba(184,150,62,.35);
      font-weight: 500;
    }
    .btn-email:hover {
      background: var(--gold-l);
      box-shadow: 0 6px 28px rgba(184,150,62,.45);
      transform: translateY(-1px);
    }
    .email-success {
      display: none;
      color: #4ade80;
      font-size: .82rem;
      letter-spacing: .1em;
      margin-top: 1.2rem;
    }

    /* ── FOOTER ── */
    footer {
      border-top: 1px solid rgba(184,150,62,.16);
      padding: 2.5rem 1.5rem;
      text-align: center;
      font-size: .6rem;
      letter-spacing: .38em;
      color: var(--ink-40);
      text-transform: uppercase;
      background: var(--washi);
    }

    /* ── RESPONSIVE ── */
    @media (max-width: 1024px) {
      .product-grid { grid-template-columns: repeat(3, 1fr); }
    }
    @media (max-width: 768px) {
      .header-inner {
        grid-template-columns: 1fr auto;
        height: auto;
        padding: .6rem 1rem;
        gap: .5rem;
      }
      .cat-nav { display: none; }
      .logo { font-size: 1.1rem; letter-spacing: .18em; }
      .hero { padding: 5rem 1.2rem 4.5rem; }
      .hero-title { letter-spacing: .06em; }
      .trust-inner { grid-template-columns: 1fr; }
      .trust-item { border-right: none; border-bottom: 1px solid rgba(184,150,62,.18); }
      .trust-item:last-child { border-bottom: none; }
      .product-grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; }
      .service-inner { grid-template-columns: 1fr; }
