  <script>
    // ── 為替レート ──
    const BASE = { USD: 108, EUR: 128, GBP: 142, AUD: 80 };
    const SYM  = { USD: '$', EUR: '€', GBP: '£', AUD: 'A$' };
    let rates  = {};

    async function loadRates() {
      try {
        const res  = await fetch('https://open.er-api.com/v6/latest/JPY');
        const data = await res.json();
        rates = {
          USD: Math.round(1 / data.rates.USD),
          EUR: Math.round(1 / data.rates.EUR),
          GBP: Math.round(1 / data.rates.GBP),
          AUD: Math.round(1 / data.rates.AUD),
        };
        // ticker
        document.getElementById('t-usd').textContent = '¥' + rates.USD;
        document.getElementById('t-eur').textContent = '¥' + rates.EUR;
        document.getElementById('t-gbp').textContent = '¥' + rates.GBP;
        document.getElementById('t-aud').textContent = '¥' + rates.AUD;

        // rate cards
        const pct = Math.round(((rates.USD - BASE.USD) / rates.USD) * 100);
        ['USD','EUR','GBP','AUD'].forEach(c => {
          const rEl = document.getElementById('r-' + c.toLowerCase());
          const bEl = document.getElementById('b-' + c.toLowerCase());
          if (rEl) rEl.textContent = '¥' + rates[c];
          const p = Math.round(((rates[c] - BASE[c]) / rates[c]) * 100);
          if (bEl) bEl.textContent = p > 0 ? '↓ ' + p + '% cheaper than 2021' : '';
        });

        document.getElementById('t-save').textContent = '↓ USD buyers save ~' + pct + '% vs 2021';
        calcSavings();
      } catch(e) {
        rates = { USD: 155, EUR: 168, GBP: 196, AUD: 100 };
        calcSavings();
      }
    }

    function calcSavings() {
      const price = parseFloat(document.getElementById('calc-price').value) || 10000;
      const cur   = document.getElementById('calc-cur').value;
      const sym   = SYM[cur];
      const now   = rates[cur] || 155;
      const base  = BASE[cur] || 108;
      const amtNow = (price / now).toFixed(2);
      const amtWas = (price / base).toFixed(2);
      const saved  = (amtWas - amtNow).toFixed(2);
      const pct    = Math.round(((amtWas - amtNow) / amtWas) * 100);
      document.getElementById('c-now').textContent  = sym + amtNow;
      document.getElementById('c-was').textContent  = sym + amtWas;
      document.getElementById('c-save').textContent = sym + saved;
      document.getElementById('c-pct').textContent  = pct + '% off vs 2021';
    }

    document.getElementById('calc-price').addEventListener('input', calcSavings);
    document.getElementById('calc-cur').addEventListener('change', calcSavings);

    // ── タブ ──
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById('panel-' + btn.dataset.tab).classList.add('active');
      });
    });

    // ── 言語切替 ──
    const LANGS = ['en','ja','zh','zhtw','ko','fr','de','es'];

    function setLang(lang) {
      if (!LANGS.includes(lang)) lang = 'en';
      document.querySelectorAll('[data-en]').forEach(el => {
        const text = el.dataset[lang] || el.dataset['en'];
        if (text) el.innerHTML = text;
      });
      const sel = document.getElementById('lang-select');
      if (sel) sel.value = lang;
      try { localStorage.setItem('jdh-lang', lang); } catch(e) {}
    }

    // selectのchangeイベントをスクリプト内でバインド（Astroモジュールスコープ対応）
    const langSel = document.getElementById('lang-select');
    if (langSel) langSel.addEventListener('change', (e) => setLang(e.target.value));

    // ページ読み込み時に保存済み言語を復元
    (function() {
      try {
        const saved = localStorage.getItem('jdh-lang');
    