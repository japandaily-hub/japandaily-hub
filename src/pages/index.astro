---
import { getCollection } from 'astro:content';
const products = await getCollection('products');
---
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>JapanDaily Hub | 厳選商品カタログ</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      .fade-out { animation: fadeOut 1.5s forwards; }
      @keyframes fadeOut { from { opacity: 1; } to { opacity: 0; visibility: hidden; } }
      .reveal { animation: revealText 2s ease-out forwards; }
      @keyframes revealText { 
        from { opacity: 0; letter-spacing: 0.2em; transform: scale(0.95); } 
        to { opacity: 1; letter-spacing: 0.5em; transform: scale(1); } 
      }
    </style>
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans">

    <!-- オープニング動画レイヤー -->
    <div id="opening" class="fixed inset-0 z-[100] flex items-center justify-center bg-black overflow-hidden">
      <video 
        id="bg-video"
        autoplay 
        muted 
        playsinline 
        class="absolute inset-0 w-full h-full object-cover opacity-50"
      >
        <source src="https://assets.mixkit.co/videos/preview/mixkit-cherry-blossoms-in-the-wind-1191-preview.mp4" type="video/mp4">
      </video>
      
      <!-- 修正済みロゴ表示 -->
      <div id="opening-logo" class="relative z-10 text-white text-center opacity-0 transition-all duration-1000">
        <h1 class="text-4xl md:text-6xl font-black uppercase tracking-[0.5em] leading-none">
          JapanDaily <br class="md:hidden"/><span class="text-orange-500">Hub</span>
        </h1>
      </div>
    </div>

    <!-- メインコンテンツ（動画終了後に表示） -->
    <div id="main-content" class="invisible">
      <header class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-slate-200">
        <div class="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between">
          <h1 class="text-xl font-black tracking-tighter text-orange-600">JapanDaily <span class="text-slate-800">Hub</span></h1>
          <span class="text-xs bg-slate-100 px-2 py-1 rounded-full font-medium text-slate-500">毎日更新</span>
        </div>
      </header>

      <main class="max-w-5xl mx-auto px-4 py-8">
        <section class="mb-12 text-center">
          <h2 class="text-3xl font-extrabold mb-3 tracking-tight text-slate-800">今日のおすすめ</h2>
          <p class="text-slate-500 text-sm">AIが日本の四季を感じるガジェットと雑貨を厳選</p>
        </section>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {products.map((item) => (
            <div class="group bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-500 border border-slate-100 flex flex-col">
              <div class="aspect-square overflow-hidden bg-slate-50 relative p-6">
                <img src={item.data.imageUrl} alt={item.data.title} class="w-full h-full object-contain group-hover:scale-110 transition-transform duration-700" />
              </div>
              <div class="p-6 flex flex-col flex-grow">
                <h3 class="font-bold text-slate-800 mb-3 leading-snug line-clamp-2 h-12 text-sm">{item.data.title}</h3>
                <div class="mt-auto">
                  <div class="flex items-baseline gap-1 mb-5">
                    <span class="text-xs font-bold text-slate-400 font-mono">JPY</span>
                    <span class="text-2xl font-black text-slate-900">¥{item.data.price.toLocaleString()}</span>
                  </div>
                  <a href={item.data.amazonUrl} target="_blank" class="block w-full bg-slate-900 text-white text-center py-4 rounded-2xl font-bold text-xs uppercase tracking-widest hover:bg-orange-600 transition-all shadow-lg shadow-slate-200">
                    Buy on Amazon
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </main>

      <footer class="mt-20 border-t border-slate-200 bg-white py-12 text-center text-slate-400 text-[10px] uppercase tracking-widest">
        © 2026 JapanDaily Hub. Built with AI.
      </footer>
    </div>

    <script>
      window.addEventListener('load', () => {
        const opening = document.getElementById('opening');
        const logo = document.getElementById('opening-logo');
        const mainContent = document.getElementById('main-content');

        // 0.5秒後にロゴをアニメーション付きで表示
        setTimeout(() => {
          logo.classList.add('reveal');
        }, 500);

        // 4.5秒後にメインへ切り替え
        setTimeout(() => {
          opening.classList.add('fade-out');
          mainContent.classList.remove('invisible');
        }, 4500);
      });
    </script>
  </body>
</html>
