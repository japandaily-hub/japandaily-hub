    .hero-eye {
      font-size: .68rem;
      letter-spacing: .5em;
      color: var(--gold-l);
      text-transform: uppercase;
      margin-bottom: 1rem;
    }
    .hero-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(2rem, 5vw, 4rem);
      font-weight: 300;
      letter-spacing: .12em;
      line-height: 1.3;
    }
    .hero-line {
      width: 44px; height: 1px;
      background: var(--gold);
      margin: 1.8rem auto;
    }
    .hero-desc {
      font-size: .82rem;
      line-height: 2;
      color: rgba(255,255,255,.55);
      letter-spacing: .08em;
    }

    /* YEN SECTION */
    .yen-section {
      background: #1a1510;
      color: #fff;
      padding: 4rem 1.5rem;
      text-align: center;
    }
