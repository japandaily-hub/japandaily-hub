      font-size: .65rem;
      letter-spacing: .45em;
      color: var(--gold-l);
      text-transform: uppercase;
      margin-bottom: .8rem;
    }
    .yen-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(1.6rem, 3.5vw, 2.8rem);
      font-weight: 300;
      letter-spacing: .1em;
      margin-bottom: 2rem;
    }
    .rate-cards {
      display: flex;
      justify-content: center;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 2.5rem;
    }
    .rate-card {
      border: 1px solid rgba(184,150,62,.25);
      border-radius: 4px;
      padding: 1.2rem 1.5rem;
      min-width: 130px;
      text-align: center;
    }
    .rate-flag { font-size: 1.6rem; margin-bottom: .3rem; }
    .rate-cur { font-size: .6rem; letter-spacing: .3em; color: rgba(255,255,255,.4); margin-bottom: .4rem; }
    .rate-val {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.7rem;
      color: #fff;
    }
    .rate-badge {
      font-size: .62rem;
      color: var(--gold-l);
      margin-top: .4rem;
      letter-spacing: .06em;
    }
    .calc-box {
      max-width: 520px;
      margin: 0 auto;
      border: 1px solid rgba(184,150,62,.25);
      border-radius: 4px;
      padding: 1.8rem;
      text-align: left;
