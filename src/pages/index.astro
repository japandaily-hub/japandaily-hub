---
import { getCollection } from 'astro:content';
import YenAdvantage from '../components/YenAdvantage.astro';
import LangSwitch from '../components/LangSwitch.astro';
import ForexTicker from '../components/ForexTicker.astro';
const products = await getCollection('products');
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Japan Daily Hub | Authentic Japanese Products</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@300;400&family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&display=swap" rel="stylesheet" />
    <style>
      :root {
        --ink:    #12100e;
        --gold:   #b8963e;
        --gold-l: #d4af5a;
        --washi:  #f6f1e9;
      }
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        background: var(--washi);
        color: var(--ink);
        font-family: 'Noto Serif JP', 'Hiragino Mincho ProN', serif;
        overflow-x: hidden;
      }

      /* ═══ OPENING — pure CSS, no JS dependency ═══════ */
      #opening {
        position: fixed; inset: 0; z-index: 300;
        display: flex; align-items: center; justify-content: center;
        background: #0a0906
          url('https://images.unsplash.com/photo-1528360983277-13d401cdc186?w=1600&q=50')
          center / cover no-repeat;
        /* 全体は5秒後にフェードアウト */
        animation: opening-exit 1.4s ease-out 4.2s forwards;
        pointer-events: none;
      }
      /* 半透明オーバーレイ */
      #opening::before {
        content: '';
        position: absolute; inset: 0;
        background: rgba(10,9,6,.62);
      }
      @keyframes opening-exit {
        to { opacity: 0; visibility: hidden; }
      }

      #opening-logo {
        position: relative; z-index: 1;
        text-align: center;
        animation: logo-in 1.6s cubic-bezier(.22,1,.36,1) .6s both;
      }
      @keyframes logo-in {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      .op-bar {
        width: 56px; height: 1px;
        background: var(--gold);
        margin: 1.1rem auto;
        animation: bar-in 1.2s ease .9s both;
        transform-origin: center;
      }
      @keyframes bar-in {
        from { transform: scaleX(0); opacity: 0; }
        to   { transform: scaleX(1); opacity: 1; }
      }

      .op-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(2rem, 6vw, 4.8rem);
        font-weight: 300;
        letter-spacing: .42em;
        color: #fff;
        text-transform: uppercase;
        line-height: 1.1;
      }
      .op-title span { color: var(--gold-l); }

      .op-sub {
        font-size: clamp(.65rem, 1.4vw, .9rem);
        letter-spacing: .55em;
        color: rgba(255,255,255,.55);
        margin-top: .6rem;
      }

      /* ═══ HEADER ══════════════════════════════════════ */
      header {
        position: sticky; top: 0; z-index: 100;
        background: rgba(246,241,233,.9);
        backdrop-filter: blur(14px);
        border-bottom: 1px solid rgba(184,150,62,.25);
      }
      .header-inner {
        max-width: 1200px; margin: 0 auto;
        padding: 0 1.5rem; height: 64px;
        display: flex; align-items: center; justify-content: space-between;
      }
      .site-name {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.3rem; font-weight: 300;
        letter-spacing: .22em; text-transform: uppercase;
        color: var(--ink);
      }
      .site-name em { color: var(--gold); font-style: normal; }

      /* ═══ TAB NAV ═════════════════════════════════════ */
      .tab-nav {
        background: rgba(246,241,233,.98);
        border-bottom: 1px solid rgba(184,150,62,.2);
        position: sticky; top: 64px; z-index: 90;
      }
      .tab-list {
        max-width: 1200px; margin: 0 auto;
        padding: 0 1.5rem;
        display: flex; overflow-x: auto; scrollbar-width: none;
      }
      .tab-list::-webkit-scrollbar { display: none; }

      .tab-btn {
        flex-shrink: 0;
        padding: .8rem 1.5rem;
        font-size: .72rem; letter-spacing: .22em;
        color: rgba(18,16,14,.45);
        border: none; background: none; cursor: pointer;
        border-bottom: 2px solid transparent;
        transition: color .2s, border-color .2s;
        font-family: inherit; white-space: nowrap;
      }
      .tab-btn:hover { color: var(--ink); }
      .tab-btn.active { color: var(--gold); border-bottom-color: var(--gold); }

      /* ═══ HERO ════════════════════════════════════════ */
      .hero {
        position: relative; overflow: hidden;
        background: var(--ink);
        color: #fff; text-align: center;
        padding: 6rem 1.5rem 5rem;
      }
      .hero-bg {
        position: absolute; inset: 0;
        background:
          url('https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?w=1600&q=60')
          center / cover no-repeat;
        opacity: .15;
      }
      .hero-inner { position: relative; z-index: 1; }

      .hero-eyebrow {
        font-size: .68rem; letter-spacing: .5em;
        color: var(--gold-l); text-transform: uppercase;
        margin-bottom: 1rem;
      }
      .hero-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(2rem, 5vw, 4rem);
        font-weight: 300; letter-spacing: .12em; line-height: 1.3;
        margin-bottom: 1rem;
      }
      .hero-rule {
        width: 44px; height: 1px;
        background: var(--gold); margin: 1.6rem auto;
      }
      .hero-desc {
        font-size: .82rem; line-height: 2.1;
        color: rgba(255,255,255,.55); letter-spacing: .08em;
      }

      /* ═══ SECTION ═════════════════════════════════════ */
      .section-wrap { max-width: 1200px; margin: 0 auto; padding: 4rem 1.5rem 5rem; }

      .section-head {
        display: flex; align-items: center; gap: 1.2rem; margin-bottom: 2.5rem;
      }
      .section-head .lbl {
        font-size: .68rem; letter-spacing: .45em;
        color: var(--gold); text-transform: uppercase; white-space: nowrap;
      }
      .section-head .rule {
        flex: 1; height: 1px;
        background: linear-gradient(to right, rgba(184,150,62,.4), transparent);
      }

      /* ═══ PRODUCT GRID ════════════════════════════════ */
      .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 1.8rem;
      }

      .product-card {
        background: #fff;
        border: 1px solid rgba(184,150,62,.12);
        display: flex; flex-direction: column;
        transition: box-shadow .3s, transform .3s;
      }
      .product-card:hover {
        box-shadow: 0 16px 48px rgba(18,16,14,.1);
        transform: translateY(-4px);
      }

      .product-img {
        aspect-ratio: 4/3; overflow: hidden;
        background: #f0ece4;
      }
      .product-img img {
        width: 100%; height: 100%;
        object-fit: contain; padding: 1rem;
        transition: transform .5s ease;
      }
      .product-card:hover .product-img img { transform: scale(1.05); }

      .product-body {
        padding: 1.3rem 1.3rem 1.5rem;
        display: flex; flex-direction: column; flex: 1;
      }
      .product-cat {
        font-size: .58rem; letter-spacing: .35em;
        color: var(--gold); text-transform: uppercase; margin-bottom: .5rem;
      }
      .product-name {
        font-size: .85rem; line-height: 1.8; letter-spacing: .04em;
        color: var(--ink); flex: 1; margin-bottom: .9rem;
      }
      .product-price {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.55rem; letter-spacing: .05em;
        color: var(--ink); margin-bottom: 1.1rem;
      }
      .product-price small {
        font-size: .85rem; color: rgba(18,16,14,.5);
      }

      /* 円安割引バッジ */
      .yen-badge {
        display: inline-block;
        font-size: .58rem; letter-spacing: .1em;
        padding: .2rem .6rem;
        background: rgba(74,222,128,.1);
        color: #16a34a;
        border: 1px solid rgba(74,222,128,.3);
        margin-bottom: .9rem;
      }

      .btn-buy {
        display: block; text-align: center;
        padding: .8rem;
        background: var(--ink); color: #fff;
        text-decoration: none; font-size: .62rem;
        letter-spacing: .38em; text-transform: uppercase;
        transition: background .22s;
      }
      .btn-buy:hover { background: var(--gold); }

      /* ═══ EMPTY ═══════════════════════════════════════ */
      .empty {
        grid-column: 1 / -1; text-align: center;
        padding: 5rem 0; font-size: .82rem;
        letter-spacing: .2em; color: rgba(18,16,14,.3);
      }

      /* ═══ FOOTER ══════════════════════════════════════ */
      footer {
        border-top: 1px solid rgba(184,150,62,.18);
        padding: 2.2rem 1.5rem; text-align: center;
        font-size: .62rem; letter-spacing: .35em;
        color: rgba(18,16,14,.3); text-transform: uppercase;
      }

      /* ═══ TAB PANEL ═══════════════════════════════════ */
      .tab-panel { display: none; }
      .tab-panel.active { display: block; }

      /* ═══ REVEAL ══════════════════════════════════════ */
      .rev { opacity: 0; transform: translateY(20px); transition: opacity .6s ease, transform .6s ease; }
      .rev.in { opacity: 1; transform: none; }
    </style>
  </head>

  <body>

    <!-- ══ OPENING (CSS-only animation) ══ -->
    <div id="opening" aria-hidden="true">
      <div id="opening-logo">
        <div class="op-bar"></div>
        <div class="op-title">Japan<em>Daily</em> <span>Hub</span></div>
        <div class="op-sub">Authentic Japanese Products</div>
        <div class="op-bar"></div>
      </div>
    </div>

    <!-- ══ MAIN (always visible) ══ -->
    <ForexTicker />

    <header>
      <div class="header-inner">
        <div class="site-name">Japan<em>Daily</em> Hub</div>
        <LangSwitch />
      </div>
    </header>

    <nav class="tab-nav" aria-label="Product categories">
      <div class="tab-list" role="tablist">
        <button class="tab-btn active" role="tab" data-tab="all"      data-en="All Products" data-ja="すべて">All Products</button>
        <button class="tab-btn"        role="tab" data-tab="food"     data-en="Food & Drink"  data-ja="飲食・食品">Food & Drink</button>
        <button class="tab-btn"        role="tab" data-tab="daily"    data-en="Daily Goods"   data-ja="日用雑貨">Daily Goods</button>
        <button class="tab-btn"        role="tab" data-tab="fashion"  data-en="Fashion"       data-ja="衣料品">Fashion</button>
        <button class="tab-btn"        role="tab" data-tab="featured" data-en="Featured"      data-ja="注目商品">Featured</button>
      </div>
    </nav>

    <!-- Hero -->
    <section class="hero">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="hero-inner">
        <p class="hero-eyebrow" data-en="Curated from Japan" data-ja="日本から厳選">Curated from Japan</p>
        <h1 class="hero-title" data-en="Japanese Beauty, Into Your Life" data-ja="日本の美しさを、あなたの暮らしへ">
          Japanese Beauty,<br />Into Your Life
        </h1>
        <div class="hero-rule"></div>
        <p class="hero-desc" data-en="Handpicked Japanese products — where tradition meets craftsmanship. Authentic quality, delivered worldwide." data-ja="伝統と職人技が交差する日本の逸品を厳選。本物の品質を世界へお届けします。">
          Handpicked Japanese products — where tradition meets craftsmanship.<br />
          Authentic quality, delivered worldwide.
        </p>
      </div>
    </section>

    <!-- Yen Advantage -->
    <YenAdvantage />

    <!-- ── Tab: ALL ── -->
    <div class="tab-panel active" id="panel-all" role="tabpanel">
      <div class="section-wrap">
        <div class="section-head">
          <span class="lbl" data-en="All Products" data-ja="すべての商品">All Products</span>
          <span class="rule"></span>
        </div>
        <div class="product-grid">
          {products.length === 0
            ? <div class="empty" data-en="Products coming soon" data-ja="商品を準備中です">Products coming soon</div>
            : products.map(item => (
              <article class="product-card rev">
                <a href={`/japandaily-hub/products/${item.id}`} style="display:block;text-decoration:none;">
                  <div class="product-img">
                    <img
                      src={item.data.imageUrl ?? `https://images.unsplash.com/photo-1528360983277-13d401cdc186?w=500&q=60`}
                      alt={item.data.title}
                      loading="lazy"
                    />
                  </div>
                </a>
                <div class="product-body">
                  <div class="product-cat">{item.data.category ?? 'Japan Select'}</div>
                  <a href={`/japandaily-hub/products/${item.id}`} style="text-decoration:none;color:inherit;">
                    <div class="product-name">{item.data.title}</div>
                  </a>
                  <div class="yen-badge">↓ ~25% cheaper due to weak yen</div>
                  <div class="product-price">
                    <small>¥</small>{(item.data.price ?? 0).toLocaleString()}
                  </div>
                  <a
                    href={item.data.amazonUrl ?? item.data.amazon_url ?? '#'}
                    class="btn-buy"
                    target="_blank"
                    rel="noopener noreferrer"
                    data-en="Buy on Amazon" data-ja="Amazonで購入"
                  >Buy on Amazon</a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>

    <!-- ── Tab: FOOD ── -->
    <div class="tab-panel" id="panel-food" role="tabpanel">
      <div class="section-wrap">
        <div class="section-head">
          <span class="lbl" data-en="Food & Drink" data-ja="飲食・食品">Food & Drink</span>
          <span class="rule"></span>
        </div>
        <div class="product-grid">
          {(() => {
            const items = products.filter(p => p.data.category === 'food');
            return items.length === 0
              ? <div class="empty" data-en="Food & Drink products coming soon" data-ja="飲食・食品カテゴリの商品を準備中です">Food & Drink products coming soon</div>
              : items.map(item => (
                <article class="product-card rev">
                  <div class="product-img">
                    <img src={item.data.imageUrl ?? ''} alt={item.data.title} loading="lazy" />
                  </div>
                  <div class="product-body">
                    <div class="product-cat" data-en="Food & Drink" data-ja="飲食・食品">Food & Drink</div>
                    <div class="product-name">{item.data.title}</div>
                    <div class="yen-badge">↓ ~25% cheaper due to weak yen</div>
                    <div class="product-price"><small>¥</small>{(item.data.price ?? 0).toLocaleString()}</div>
                    <a href={item.data.amazonUrl ?? item.data.amazon_url ?? '#'} class="btn-buy" target="_blank" rel="noopener" data-en="Buy on Amazon" data-ja="Amazonで購入">Buy on Amazon</a>
                  </div>
                </article>
              ));
          })()}
        </div>
      </div>
    </div>

    <!-- ── Tab: DAILY ── -->
    <div class="tab-panel" id="panel-daily" role="tabpanel">
      <div class="section-wrap">
        <div class="section-head">
          <span class="lbl" data-en="Daily Goods" data-ja="日用雑貨">Daily Goods</span>
          <span class="rule"></span>
        </div>
        <div class="product-grid">
          {(() => {
            const items = products.filter(p => p.data.category === 'daily');
            return items.length === 0
              ? <div class="empty" data-en="Daily Goods coming soon" data-ja="日用雑貨カテゴリの商品を準備中です">Daily Goods coming soon</div>
              : items.map(item => (
                <article class="product-card rev">
                  <div class="product-img">
                    <img src={item.data.imageUrl ?? ''} alt={item.data.title} loading="lazy" />
                  </div>
                  <div class="product-body">
                    <div class="product-cat" data-en="Daily Goods" data-ja="日用雑貨">Daily Goods</div>
                    <div class="product-name">{item.data.title}</div>
                    <div class="yen-badge">↓ ~25% cheaper due to weak yen</div>
                    <div class="product-price"><small>¥</small>{(item.data.price ?? 0).toLocaleString()}</div>
                    <a href={item.data.amazonUrl ?? item.data.amazon_url ?? '#'} class="btn-buy" target="_blank" rel="noopener" data-en="Buy on Amazon" data-ja="Amazonで購入">Buy on Amazon</a>
                  </div>
                </article>
              ));
          })()}
        </div>
      </div>
    </div>

    <!-- ── Tab: FASHION ── -->
    <div class="tab-panel" id="panel-fashion" role="tabpanel">
      <div class="section-wrap">
        <div class="section-head">
          <span class="lbl" data-en="Fashion" data-ja="衣料品">Fashion</span>
          <span class="rule"></span>
        </div>
        <div class="product-grid">
          {(() => {
            const items = products.filter(p => p.data.category === 'fashion');
            return items.length === 0
              ? <div class="empty" data-en="Fashion items coming soon" data-ja="衣料品カテゴリの商品を準備中です">Fashion items coming soon</div>
              : items.map(item => (
                <article class="product-card rev">
                  <div class="product-img">
                    <img src={item.data.imageUrl ?? ''} alt={item.data.title} loading="lazy" />
                  </div>
                  <div class="product-body">
                    <div class="product-cat" data-en="Fashion" data-ja="衣料品">Fashion</div>
                    <div class="product-name">{item.data.title}</div>
                    <div class="yen-badge">↓ ~25% cheaper due to weak yen</div>
                    <div class="product-price"><small>¥</small>{(item.data.price ?? 0).toLocaleString()}</div>
                    <a href={item.data.amazonUrl ?? item.data.amazon_url ?? '#'} class="btn-buy" target="_blank" rel="noopener" data-en="Buy on Amazon" data-ja="Amazonで購入">Buy on Amazon</a>
                  </div>
                </article>
              ));
          })()}
        </div>
      </div>
    </div>

    <!-- ── Tab: FEATURED ── -->
    <div class="tab-panel" id="panel-featured" role="tabpanel">
      <div class="section-wrap">
        <div class="section-head">
          <span class="lbl" data-en="Featured" data-ja="注目商品">Featured</span>
          <span class="rule"></span>
        </div>
        <div class="product-grid">
          {(() => {
            const items = products.filter(p => p.data.featured);
            return items.length === 0
              ? <div class="empty" data-en="Featured products coming soon" data-ja="注目商品を準備中です">Featured products coming soon</div>
              : items.map(item => (
                <article class="product-card rev">
                  <div class="product-img">
                    <img src={item.data.imageUrl ?? ''} alt={item.data.title} loading="lazy" />
                  </div>
                  <div class="product-body">
                    <div class="product-cat" data-en="Featured" data-ja="注目商品">Featured</div>
                    <div class="product-name">{item.data.title}</div>
                    <div class="yen-badge">↓ ~25% cheaper due to weak yen</div>
                    <div class="product-price"><small>¥</small>{(item.data.price ?? 0).toLocaleString()}</div>
                    <a href={item.data.amazonUrl ?? item.data.amazon_url ?? '#'} class="btn-buy" target="_blank" rel="noopener" data-en="Buy on Amazon" data-ja="Amazonで購入">Buy on Amazon</a>
                  </div>
                </article>
              ));
          })()}
        </div>
      </div>
    </div>

    <footer>
      &copy; 2025 Japan Daily Hub &nbsp;|&nbsp;
      <span data-en="Authentic Japanese Products, Delivered Worldwide" data-ja="日本の逸品、世界へ">
        Authentic Japanese Products, Delivered Worldwide
      </span>
    </footer>

    <script>
      // ── Tab switching ──
      document.querySelectorAll<HTMLButtonElement>('.tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
          document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
          btn.classList.add('active');
          document.getElementById('panel-' + btn.dataset.tab)?.classList.add('active');
          revealCards();
        });
      });

      // ── Scroll reveal ──
      function revealCards() {
        const io = new IntersectionObserver(entries => {
          entries.forEach((e, i) => {
            if (e.isIntersecting) {
              setTimeout(() => e.target.classList.add('in'), i * 70);
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.08 });
        document.querySelectorAll<HTMLElement>('.rev:not(.in)').forEach(el => io.observe(el));
      }
      revealCards();
    </script>
  </body>
</html>
