---
import { getCollection } from 'astro:content';
import YenAdvantage from '../components/YenAdvantage.astro';
import LangSwitch from '../components/LangSwitch.astro';
import ForexTicker from '../components/ForexTicker.astro';
const products = await getCollection('products');
const base = '/japandaily-hub';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Japan Daily Hub | Authentic Japanese Products</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@300;400&family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&display=swap" rel="stylesheet" />
    <style>
      :root { --ink:#12100e; --gold:#b8963e; --gold-l:#d4af5a; --washi:#f6f1e9; }
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        background: var(--washi);
        color: var(--ink);
        font-family: 'Noto Serif JP','Hiragino Mincho ProN', serif;
        overflow-x: hidden;
      }

      /* HEADER */
      header {
        position: sticky; top: 0; z-index: 100;
        background: rgba(246,241,233,.92);
        backdrop-filter: blur(14px);
        border-bottom: 1px solid rgba(184,150,62,.25);
      }
      .header-inner {
        max-width: 1200px; margin: 0 auto;
        padding: 0 1.5rem; height: 64px;
        display: flex; align-items: center; justify-content: space-between;
      }
      .site-name {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.3rem; font-weight: 300;
        letter-spacing: .22em; text-transform: uppercase; color: var(--ink);
      }
      .site-name em { color: var(--gold); font-style: normal; }

      /* TAB NAV */
      .tab-nav {
        background: rgba(246,241,233,.98);
        border-bottom: 1px solid rgba(184,150,62,.2);
        position: sticky; top: 64px; z-index: 90;
      }
      .tab-list {
        max-width: 1200px; margin: 0 auto;
        padding: 0 1.5rem;
        display: flex; overflow-x: auto; scrollbar-width: none;
      }
      .tab-list::-webkit-scrollbar { display: none; }
      .tab-btn {
        flex-shrink: 0; padding: .8rem 1.5rem;
        font-size: .72rem; letter-spacing: .22em;
        color: rgba(18,16,14,.45);
        border: none; background: none; cursor: pointer;
        border-bottom: 2px solid transparent;
        transition: color .2s, border-color .2s;
        font-family: inherit; white-space: nowrap;
      }
      .tab-btn:hover { color: var(--ink); }
      .tab-btn.active { color: var(--gold); border-bottom-color: var(--gold); }

      /* HERO */
      .hero {
        position: relative; overflow: hidden;
        background: var(--ink); color: #fff;
        text-align: center; padding: 6rem 1.5rem 5rem;
      }
      .hero::before {
        content: ''; position: absolute; inset: 0;
        background: url('https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?w=1600&q=60') center/cover no-repeat;
        opacity: .15;
      }
      .hero-inner { position: relative; z-index: 1; }
      .hero-eyebrow {
        font-size: .68rem; letter-spacing: .5em;
        color: var(--gold-l); text-transform: uppercase; margin-bottom: 1rem;
      }
      .hero-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(2rem, 5vw, 4rem);
        font-weight: 300; letter-spacing: .12em; line-height: 1.3; margin-bottom: 1rem;
      }
      .hero-rule { width: 44px; height: 1px; background: var(--gold); margin: 1.6rem auto; }
      .hero-desc {
        font-size: .82rem; line-height: 2.1;
        color: rgba(255,255,255,.55); letter-spacing: .08em;
      }

      /* SECTION */
      .section-wrap { max-width: 1200px; margin: 0 auto; padding: 4rem 1.5rem 5rem; }
      .section-head { display: flex; align-items: center; gap: 1.2rem; margin-bottom: 2.5rem; }
      .section-head .lbl {
        font-size: .68rem; letter-spacing: .45em;
        color: var(--gold); text-transform: uppercase; white-space: nowrap;
      }
      .section-head .rule {
        flex: 1; height: 1px;
        background: linear-gradient(to right, rgba(184,150,62,.4), transparent);
      }

      /* PRODUCT GRID */
      .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 1.8rem;
      }
      .product-card {
        background: #fff;
        border: 1px solid rgba(184,150,62,.12);
        display: flex; flex-direction: column;
        transition: box-shadow .3s, transform .3s;
      }
      .product-card:hover {
        box-shadow: 0 16px 48px rgba(18,16,14,.1);
        transform: translateY(-4px);
      }
      .product-img { aspect-ratio: 4/3; overflow: hidden; background: #f0ece4; }
      .product-img img {
        width: 100%; height: 100%; object-fit: contain; padding: 1rem;
        transition: transform .5s ease;
      }
      .product-card:hover .product-img img { transform: scale(1.05); }
      .product-body { padding: 1.3rem 1.3rem 1.5rem; display: flex; flex-direction: column; flex: 1; }
      .product-cat { font-size: .58rem; letter-spacing: .35em; color: var(--gold); text-transform: uppercase; margin-bottom: .5rem; }
      .product-name { font-size: .85rem; line-height: 1.8; letter-spacing: .04em; color: var(--ink); flex: 1; margin-bottom: .9rem; }
      .yen-badge {
        display: inline-block; font-size: .58rem; letter-spacing: .1em;
        padding: .2rem .6rem; margin-bottom: .9rem;
        background: rgba(74,222,128,.1); color: #16a34a;
        border: 1px solid rgba(74,222,128,.3);
      }
      .product-price {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.55rem; letter-spacing: .05em; color: var(--ink); margin-bottom: 1.1rem;
      }
      .product-price small { font-size: .85rem; color: rgba(18,16,14,.5); }
      .btn-buy {
        display: block; text-align: center; padding: .8rem;
        background: var(--ink); color: #fff; text-decoration: none;
        font-size: .62rem; letter-spacing: .38em; text-transform: uppercase;
        transition: background .22s;
      }
      .btn-buy:hover { background: var(--gold); }

      /* EMPTY */
      .empty {
        grid-column: 1/-1; text-align: center; padding: 5rem 0;
        font-size: .82rem; letter-spacing: .2em; color: rgba(18,16,14,.3);
      }

      /* FOOTER */
      footer {
        border-top: 1px solid rgba(184,150,62,.18);
        padding: 2.2rem 1.5rem; text-align: center;
        font-size: .62rem; letter-spacing: .35em;
        color: rgba(18,16,14,.3); text-transform: uppercase;
      }

      /* TAB PANEL */
      .tab-panel { display: none; }
      .tab-panel.active { display: block; }
    </style>
  </head>
  <body>

    <ForexTicker />

    <header>
      <div class="header-inner">
        <div class="site-name">Japan<em>Daily</em> Hub</div>
        <LangSwitch />
      </div>
    </header>

    <nav class="tab-nav">
      <div class="tab-list" role="tablist">
        <button class="tab-btn active" data-tab="all"      data-en="All Products" data-ja="すべて">All Products</button>
        <button class="tab-btn"        data-tab="food"     data-en="Food & Drink"  data-ja="飲食・食品">Food & Drink</button>
        <button class="tab-btn"        data-tab="daily"    data-en="Daily Goods"   data-ja="日用雑貨">Daily Goods</button>
        <button class="tab-btn"        data-tab="fashion"  data-en="Fashion"       data-ja="衣料品">Fashion</button>
        <button class="tab-btn"        data-tab="featured" data-en="Featured"      data-ja="注目商品">Featured</button>
      </div>
    </nav>

    <section class="hero">
      <div class="hero-inner">
        <p class="hero-eyebrow" data-en="Curated from Japan" data-ja="日本から厳選">Curated from Japan</p>
        <h1 class="hero-title" data-en="Japanese Beauty, Into Your Life" data-ja="日本の美しさを、あなたの暮らしへ">
          Japanese Beauty,<br />Into Your Life
        </h1>
        <div class="hero-rule"></div>
        <p class="hero-desc" data-en="Handpicked Japanese products — where tradition meets craftsmanship." data-ja="伝統と職人技が交差する日本の逸品を厳選。">
          Handpicked Japanese products — where tradition meets craftsmanship.
        </p>
      </div>
    </section>

    <YenAdvantage />

    <!-- ALL -->
    <div class="tab-panel active" id="panel-all">
      <div class="section-wrap">
        <div class="section-head">
          <span class="lbl" data-en="All Products" data-ja="すべての商品">All Products</span>
          <span class="rule"></span>
        </div>
        <div class="product-grid">
          {products.length === 0
            ? <div class="empty" data-en="Products coming soon" data-ja="商品を準備中です">Products coming soon</div>
            : products.map(item => (
              <article class="product-card">
                <a href={`${base}/products/${item.id}`} style="display:block;text-decoration:none;">
                  <div class="product-img">
                    <img src={item.data.imageUrl ?? 'https://images.unsplash.com/photo-1528360983277-13d401cdc186?w=500&q=60'} alt={item.data.title} loading="lazy" />
                  </div>
                </a>
                <div class="product-body">
                  <div class="product-cat">{item.data.category ?? 'Japan Select'}</div>
                  <a href={`${base}/products/${item.id}`} style="text-decoration:none;color:inherit;">
                    <div class="product-name">{item.data.title}</div>
                  </a>
                  <div class="yen-badge">↓ ~25% cheaper due to weak yen</div>
                  <div class="product-price"><small>¥</small>{(item.data.price ?? 0).toLocaleString()}</div>
                  <a href={item.data.amazonUrl ?? item.data.amazon_url ?? '#'} class="btn-buy" target="_blank" rel="noopener" data-en="Buy on Amazon" data-ja="Amazonで購入">Buy on Amazon</a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>

    <!-- FOOD -->
    <div class="tab-panel" id="panel-food">
      <div class="section-wrap">
        <div class="section-head"><span class="lbl" data-en="Food & Drink" data-ja="飲食・食品">Food & Drink</span><span class="rule"></span></div>
        <div class="product-grid">
          {(() => { const items = products.filter(p => p.data.category === 'food'); return items.length === 0 ? <div class="empty" data-en="Coming soon" data-ja="準備中">Coming soon</div> : items.map(item => (<article class="product-card"><a href={`${base}/products/${item.id}`} style="display:block;text-decoration:none;"><div class="product-img"><img src={item.data.imageUrl ?? ''} alt={item.data.title} loading="lazy" /></div></a><div class="product-body"><div class="product-cat" data-en="Food & Drink" data-ja="飲食・食品">Food & Drink</div><div class="product-name">{item.data.title}</div><div class="yen-badge">↓ ~25% cheaper due to weak yen</div><div class="product-price"><small>¥</small>{(item.data.price ?? 0).toLocaleString()}</div><a href={item.data.amazonUrl ?? item.data.amazon_url ?? '#'} class="btn-buy" target="_blank" rel="noopener" data-en="Buy on Amazon" data-ja="Amazonで購入">Buy on Amazon</a></div></article>)); })()}
        </div>
      </div>
    </div>

    <!-- DAILY -->
    <div class="tab-panel" id="panel-daily">
      <div class="section-wrap">
        <div class="section-head"><span class="lbl" data-en="Daily Goods" data-ja="日用雑貨">Daily Goods</span><span class="rule"></span></div>
        <div class="product-grid">
          {(() => { const items = products.filter(p => p.data.category === 'daily'); return items.length === 0 ? <div class="empty" data-en="Coming soon" data-ja="準備中">Coming soon</div> : items.map(item => (<article class="product-card"><a href={`${base}/products/${item.id}`} style="display:block;text-decoration:none;"><div class="product-img"><img src={item.data.imageUrl ?? ''} alt={item.data.title} loading="lazy" /></div></a><div class="product-body"><div class="product-cat" data-en="Daily Goods" data-ja="日用雑貨">Daily Goods</div><div class="product-name">{item.data.title}</div><div class="yen-badge">↓ ~25% cheaper due to weak yen</div><div class="product-price"><small>¥</small>{(item.data.price ?? 0).toLocaleString()}</div><a href={item.data.amazonUrl ?? item.data.amazon_url ?? '#'} class="btn-buy" target="_blank" rel="noopener" data-en="Buy on Amazon" data-ja="Amazonで購入">Buy on Amazon</a></div></article>)); })()}
        </div>
      </div>
    </div>

    <!-- FASHION -->
    <div class="tab-panel" id="panel-fashion">
      <div class="section-wrap">
        <div class="section-head"><span class="lbl" data-en="Fashion" data-ja="衣料品">Fashion</span><span class="rule"></span></div>
        <div class="product-grid">
          {(() => { const items = products.filter(p => p.data.category === 'fashion'); return items.length === 0 ? <div class="empty" data-en="Coming soon" data-ja="準備中">Coming soon</div> : items.map(item => (<article class="product-card"><a href={`${base}/products/${item.id}`} style="display:block;text-decoration:none;"><div class="product-img"><img src={item.data.imageUrl ?? ''} alt={item.data.title} loading="lazy" /></div></a><div class="product-body"><div class="product-cat" data-en="Fashion" data-ja="衣料品">Fashion</div><div class="product-name">{item.data.title}</div><div class="yen-badge">↓ ~25% cheaper due to weak yen</div><div class="product-price"><small>¥</small>{(item.data.price ?? 0).toLocaleString()}</div><a href={item.data.amazonUrl ?? item.data.amazon_url ?? '#'} class="btn-buy" target="_blank" rel="noopener" data-en="Buy on Amazon" data-ja="Amazonで購入">Buy on Amazon</a></div></article>)); })()}
        </div>
      </div>
    </div>

    <!-- FEATURED -->
    <div class="tab-panel" id="panel-featured">
      <div class="section-wrap">
        <div class="section-head"><span class="lbl" data-en="Featured" data-ja="注目商品">Featured</span><span class="rule"></span></div>
        <div class="product-grid">
          {(() => { const items = products.filter(p => p.data.featured); return items.length === 0 ? <div class="empty" data-en="Coming soon" data-ja="準備中">Coming soon</div> : items.map(item => (<article class="product-card"><a href={`${base}/products/${item.id}`} style="display:block;text-decoration:none;"><div class="product-img"><img src={item.data.imageUrl ?? ''} alt={item.data.title} loading="lazy" /></div></a><div class="product-body"><div class="product-cat" data-en="Featured" data-ja="注目商品">Featured</div><div class="product-name">{item.data.title}</div><div class="yen-badge">↓ ~25% cheaper due to weak yen</div><div class="product-price"><small>¥</small>{(item.data.price ?? 0).toLocaleString()}</div><a href={item.data.amazonUrl ?? item.data.amazon_url ?? '#'} class="btn-buy" target="_blank" rel="noopener" data-en="Buy on Amazon" data-ja="Amazonで購入">Buy on Amazon</a></div></article>)); })()}
        </div>
      </div>
    </div>

    <footer>
      &copy; 2025 Japan Daily Hub &nbsp;|&nbsp;
      <span data-en="Authentic Japanese Products, Delivered Worldwide" data-ja="日本の逸品、世界へ">Authentic Japanese Products, Delivered Worldwide</span>
    </footer>

    <script>
      document.querySelectorAll<HTMLButtonElement>('.tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
          document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
          btn.classList.add('active');
          document.getElementById('panel-' + btn.dataset.tab)?.classList.add('active');
        });
      });
    </script>
  </body>
</html>
