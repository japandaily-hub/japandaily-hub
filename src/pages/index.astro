      data-ko="✓ 등록 완료! 할인 정보와 특별 상품을 정기적으로 받아보실 수 있습니다."
      data-fr="✓ Inscrit(e) ! Vous recevrez régulièrement des offres et produits exclusifs."
      data-de="✓ Angemeldet! Sie erhalten regelmäßig Angebote und exklusive Produkte."
      data-es="✓ ¡Suscrito! Recibirás ofertas y productos especiales regularmente.">
      ✓ Subscribed! You'll receive sale alerts and special deals regularly.
    </p>
  </section>

  <footer>
    &copy; 2025 Japan Daily Hub &nbsp;|&nbsp;
    <span
      data-en="Authentic Japanese Products, Delivered Worldwide"
      data-ja="日本の逸品、世界へ"
      data-zh="正宗日本商品，全球配送"
      data-zhtw="正宗日本商品，全球配送"
      data-ko="정품 일본 상품, 전 세계 배송"
      data-fr="Produits Japonais Authentiques, Livrés Partout"
      data-de="Authentische Japanische Produkte, Weltweit Geliefert"
      data-es="Productos Japoneses Auténticos, Entregados en Todo el Mundo">Authentic Japanese Products, Delivered Worldwide</span>
  </footer>

  <script is:inline>
    // ── 言語切替 ──
    const LANGS = ['en','ja','zh','zhtw','ko','fr','de','es'];

    function setLang(lang) {
      if (!LANGS.includes(lang)) lang = 'en';
      document.querySelectorAll('[data-en]').forEach(el => {
        const text = el.dataset[lang] || el.dataset['en'];
        if (text) el.innerHTML = text;
      });
      const sel = document.getElementById('lang-select');
      if (sel) sel.value = lang;
      try { localStorage.setItem('jdh-lang', lang); } catch(e) {}
      if (document.getElementById('wl-drawer')?.classList.contains('open')) {
        renderWLBody();
      }
    }

    const langSel = document.getElementById('lang-select');
    if (langSel) langSel.addEventListener('change', (e) => setLang(e.target.value));

    (async function() {
      try {
        const saved = localStorage.getItem('jdh-lang');
        if (saved && LANGS.includes(saved)) { setLang(saved); return; }
      } catch(e) {}
      try {
        const r = await fetch('https://ipapi.co/json/');
        const d = await r.json();
        const cc = (d.country_code || '').toUpperCase();
        const geo = {
          JP:'ja', CN:'zh', TW:'zhtw', HK:'zhtw', MO:'zhtw', KR:'ko',
          FR:'fr', BE:'fr', LU:'fr', DE:'de', AT:'de',
          ES:'es', MX:'es', AR:'es', CO:'es', PE:'es', VE:'es', CL:'es',
          EC:'es', BO:'es', PY:'es', UY:'es', CU:'es', PR:'es',
          DO:'es', GT:'es', HN:'es', SV:'es', NI:'es', CR:'es', PA:'es'
        };
        setLang(geo[cc] || 'en');
      } catch(e) { setLang('en'); }
    })();

    // ── カテゴリフィルター ──
    const catTabs = document.querySelectorAll('.cat-tab');
    catTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        catTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        const cat = tab.dataset.cat;
        document.querySelectorAll('.product-card').forEach(card => {
          if (cat === 'all' || card.dataset.category === cat) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });

    // ── ウィッシュリスト ──
    const WL_KEY = 'jdh-wishlist';

    function getWL() {
      try { return JSON.parse(localStorage.getItem(WL_KEY) || '[]'); } catch { return []; }
    }
    function saveWL(list) {
      try { localStorage.setItem(WL_KEY, JSON.stringify(list)); } catch {}
    }

    function addToWL(id, title, price, img) {
      const list = getWL();
      if (!list.find(i => i.id === id)) {
        list.push({ id, title, price, img });
        saveWL(list);
      }
      renderWLCount();
      // highlight button
      const btn = document.querySelector(`.btn-wl[data-wl-id="${id}"]`);
      if (btn) { btn.classList.add('active'); btn.textContent = '♥'; }
    }

    function renderWLCount() {
      const list = getWL();
      const countEl = document.getElementById('wl-count');
      if (!countEl) return;
      countEl.textContent = list.length;
      countEl.classList.toggle('visible', list.length > 0);
    }

    function renderWLBody() {
      const list = getWL();
      const body = document.getElementById('wl-body');
      if (!body) return;
      if (list.length === 0) {
        const lang = document.getElementById('lang-select')?.value || 'en';
        const emptyMsgs = { en:'Your wishlist is empty', ja:'リストは空です', zh:'心愿单为空', zhtw:'心願單為空', ko:'위시리스트가 비어 있습니다', fr:'Votre liste est vide', de:'Ihre Wunschliste ist leer', es:'Tu lista está vacía' };
        body.innerHTML = `<div class="wl-empty">${emptyMsgs[lang] || emptyMsgs.en}</div>`;
        return;
      }
      body.innerHTML = list.map(item => `
        <div class="wl-item">
          <img class="wl-item-img" src="${item.img || 'https://images.unsplash.com/photo-1528360983277-13d401cdc186?w=120&q=60'}" alt="${item.title}" loading="lazy" />
          <div class="wl-item-info">
            <div class="wl-item-name">${item.title}</div>
            <div class="wl-item-price">&#165;${Number(item.price).toLocaleString()}</div>
          </div>
          <button class="wl-item-remove" data-id="${item.id}" aria-label="Remove">&#215;</button>
        </div>
      `).join('');
      body.querySelectorAll('.wl-item-remove').forEach(btn => {
        btn.addEventListener('click', () => {
          const removedId = btn.dataset.id;
          saveWL(getWL().filter(i => i.id !== removedId));
          // reset card button
          const cardBtn = document.querySelector(`.btn-wl[data-wl-id="${removedId}"]`);
          if (cardBtn) { cardBtn.classList.remove('active'); cardBtn.textContent = '♡'; }
          renderWLBody(); renderWLCount();
        });
      });
    }

    // Bind wishlist card buttons
    document.querySelectorAll('.btn-wl').forEach(btn => {
      // restore active state from localStorage
      const id = btn.dataset.wlId;
      if (getWL().find(i => i.id === id)) {
        btn.classList.add('active'); btn.textContent = '♥';
      }
      btn.addEventListener('click', () => {
        const list = getWL();
        if (list.find(i => i.id === id)) {
          // toggle off
          saveWL(list.filter(i => i.id !== id));
          btn.classList.remove('active'); btn.textContent = '♡';
          renderWLCount();
        } else {
          addToWL(id, btn.dataset.wlTitle, btn.dataset.wlPrice, btn.dataset.wlImg);
        }
      });
    });

    function openDrawer() {
      renderWLBody();
      document.getElementById('wl-drawer')?.classList.add('open');
      document.getElementById('wl-overlay')?.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeDrawer() {
      document.getElementById('wl-drawer')?.classList.remove('open');
      document.getElementById('wl-overlay')?.classList.remove('open');
      document.body.style.overflow = '';
    }

    document.getElementById('wl-open-btn')?.addEventListener('click', openDrawer);
    document.getElementById('wl-close-btn')?.addEventListener('click', closeDrawer);
    document.getElementById('wl-overlay')?.addEventListener('click', closeDrawer);
    document.getElementById('wl-clear-btn')?.addEventListener('click', () => {
      saveWL([]);
      document.querySelectorAll('.btn-wl').forEach(b => { b.classList.remove('active'); b.textContent = '♡'; });
      renderWLBody(); renderWLCount();
    });

    renderWLCount();

    // ── メール登録 ──
    document.getElementById('email-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = document.getElementById('email-input')?.value?.trim();
      if (!email) return;
      try {
        const subs = JSON.parse(localStorage.getItem('jdh-subscribers') || '[]');
        if (!subs.includes(email)) { subs.push(email); localStorage.setItem('jdh-subscribers', JSON.stringify(subs)); }
      } catch {}
      const form = document.getElementById('email-form');
      const success = document.getElementById('email-success');
      if (form) form.style.display = 'none';
      if (success) success.style.display = 'block';
    });
  </script>

</body>
</html>
