      <div class="rate-card"><div class="rate-flag">🇬🇧</div><div class="rate-cur">GBP</div><div class="rate-val" id="r-gbp">…</div><div class="rate-badge" id="b-gbp"></div></div>
      <div class="rate-card"><div class="rate-flag">🇦🇺</div><div class="rate-cur">AUD</div><div class="rate-val" id="r-aud">…</div><div class="rate-badge" id="b-aud"></div></div>
