  <footer>
    &copy; 2025 Japan Daily Hub &nbsp;|&nbsp;
    <span
      data-en="Authentic Japanese Products, Delivered Worldwide"
      data-ja="日本の逸品、世界へ"
      data-zh="正宗日本商品，全球配送"
      data-zhtw="正宗日本商品，全球配送"
      data-ko="정품 일본 상품, 전 세계 배송"
      data-fr="Produits Japonais Authentiques, Livrés Partout"
      data-de="Authentische Japanische Produkte, Weltweit Geliefert"
      data-es="Productos Japoneses Auténticos, Entregados en Todo el Mundo">Authentic Japanese Products, Delivered Worldwide</span>
  </footer>

  <script>
    // ── 為替レート ──
    const BASE = { USD: 108, EUR: 128, GBP: 142, AUD: 80 };
    const SYM  = { USD: '$', EUR: '€', GBP: '£', AUD: 'A$' };
    let rates  = {};

    async function loadRates() {
      try {
        const res  = await fetch('https://open.er-api.com/v6/latest/JPY');
        const data = await res.json();
        rates = {
          USD: Math.round(1 / data.rates.USD),
          EUR: Math.round(1 / data.rates.EUR),
          GBP: Math.round(1 / data.rates.GBP),
          AUD: Math.round(1 / data.rates.AUD),
        };
        // ticker
        document.getElementById('t-usd').textContent = '¥' + rates.USD;
        document.getElementById('t-eur').textContent = '¥' + rates.EUR;
        document.getElementById('t-gbp').textContent = '¥' + rates.GBP;
        document.getElementById('t-aud').textContent = '¥' + rates.AUD;

        // rate cards
        const pct = Math.round(((rates.USD - BASE.USD) / rates.USD) * 100);
        ['USD','EUR','GBP','AUD'].forEach(c => {
          const rEl = document.getElementById('r-' + c.toLowerCase());
          const bEl = document.getElementById('b-' + c.toLowerCase());
          if (rEl) rEl.textContent = '¥' + rates[c];
          const p = Math.round(((rates[c] - BASE[c]) / rates[c]) * 100);
          if (bEl) bEl.textContent = p > 0 ? '↓ ' + p + '% cheaper than 2021' : '';
        });

        document.getElementById('t-save').textContent = '↓ USD buyers save ~' + pct + '% vs 2021';
        calcSavings();
        updateSaveBadges();
      } catch(e) {
        rates = { USD: 155, EUR: 168, GBP: 196, AUD: 100 };
        calcSavings();
        updateSaveBadges();
      }
    }

    function updateSaveBadges() {
      const usdRate = rates.USD || 155;
      document.querySelectorAll('.save-badge[data-price]').forEach(badge => {
        const price = Number(badge.dataset.price) || 0;
        if (!price) { badge.textContent = ''; return; }
        const usdNow = price / usdRate;
        const usdWas = price / 108;
        const saved  = usdWas - usdNow;
        const pct    = Math.round((saved / usdWas) * 100);
        if (pct > 0) {
          badge.textContent = '↓ Save $' + saved.toFixed(0) + ' (' + pct + '% vs 2021)';
          badge.style.display = '';
        } else {
          badge.style.display = 'none';
        }
      });
    }

    function calcSavings() {
      const price = parseFloat(document.getElementById('calc-price').value) || 10000;
      const cur   = document.getElementById('calc-cur').value;
      const sym   = SYM[cur];
      const now   = rates[cur] || 155;
      const base  = BASE[cur] || 108;
      const amtNow = (price / now).toFixed(2);
      const amtWas = (price / base).toFixed(2);
      const saved  = (amtWas - amtNow).toFixed(2);
      const pct    = Math.round(((amtWas - amtNow) / amtWas) * 100);
      document.getElementById('c-now').textContent  = sym + amtNow;
      document.getElementById('c-was').textContent  = sym + amtWas;
      document.getElementById('c-save').textContent = sym + saved;
      document.getElementById('c-pct').textContent  = pct + '% off vs 2021';
    }

    document.getElementById('calc-price').addEventListener('input', calcSavings);
    document.getElementById('calc-cur').addEventListener('change', calcSavings);

    // ── タブ (client-side filter) ──
    const TAB_LABELS = {
      all:     { en:'All Products',   ja:'すべての商品', zh:'全部商品', zhtw:'全部商品', ko:'전체 상품',    fr:'Tous les Produits',  de:'Alle Produkte',  es:'Todos los Productos' },
      food:    { en:'Food & Drink',   ja:'飲食・食品',   zh:'食品饮料', zhtw:'食品飲料', ko:'식품·음료',    fr:'Alimentation',       de:'Essen & Trinken', es:'Comida y Bebida' },
      daily:   { en:'Daily Goods',    ja:'日用雑貨',     zh:'日用品',   zhtw:'日用品',   ko:'생활용품',     fr:'Articles Quotidiens', de:'Alltagswaren',   es:'Artículos Diarios' },
      fashion: { en:'Fashion',        ja:'ファッション', zh:'时尚',     zhtw:'時尚',     ko:'패션',         fr:'Mode',               de:'Mode',           es:'Moda' },
    };

    function applyTab(tab) {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.toggle('active', b.dataset.tab === tab));
      const cards = document.querySelectorAll('.product-card');
      let visible = 0;
      cards.forEach(card => {
        const show = tab === 'all' || card.dataset.tab === tab;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      const lbl = document.getElementById('section-lbl-text');
      if (lbl) {
        const lang = document.getElementById('lang-select')?.value || 'en';
        lbl.textContent = TAB_LABELS[tab]?.[lang] || TAB_LABELS[tab]?.en || tab;
      }
      const cnt = document.getElementById('product-count');
      if (cnt) cnt.textContent = visible + ' items';
    }

    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => applyTab(btn.dataset.tab));
    });
    applyTab('all');

    // ── 言語切替 ──
    const LANGS = ['en','ja','zh','zhtw','ko','fr','de','es'];

    function setLang(lang) {
      if (!LANGS.includes(lang)) lang = 'en';
      document.querySelectorAll('[data-en]').forEach(el => {
        const text = el.dataset[lang] || el.dataset['en'];
        if (text) el.innerHTML = text;
      });
      const sel = document.getElementById('lang-select');
      if (sel) sel.value = lang;
      try { localStorage.setItem('jdh-lang', lang); } catch(e) {}
    }

    // selectのchangeイベントをスクリプト内でバインド（Astroモジュールスコープ対応）
    const langSel = document.getElementById('lang-select');
    if (langSel) langSel.addEventListener('change', (e) => setLang(e.target.value));

    // ページ読み込み時に保存済み言語を復元
    (function() {
      try {
        const saved = localStorage.getItem('jdh-lang');
        if (saved && LANGS.includes(saved)) setLang(saved);
      } catch(e) {}
    })();

    loadRates();
    setInterval(loadRates, 5 * 60 * 1000);

    // ── ウィッシュリスト ──
    const WL_KEY = 'jdh-wishlist';

    function getWL() {
      try { return JSON.parse(localStorage.getItem(WL_KEY) || '[]'); } catch { return []; }
    }
    function saveWL(list) {
      try { localStorage.setItem(WL_KEY, JSON.stringify(list)); } catch {}
    }

    function renderWLCount() {
      const list = getWL();
      const countEl = document.getElementById('wl-count');
      if (!countEl) return;
      countEl.textContent = list.length;
      countEl.classList.toggle('visible', list.length > 0);
    }

    function renderWLBody() {
      const list = getWL();
      const body = document.getElementById('wl-body');
      if (!body) return;
      if (list.length === 0) {
        body.innerHTML = '<div class="wl-empty">Your wishlist is empty</div>';
        return;
      }
      body.innerHTML = list.map(item => `
        <div class="wl-item">
          <img class="wl-item-img" src="${item.img || 'https://images.unsplash.com/photo-1528360983277-13d401cdc186?w=120&q=60'}" alt="${item.title}" loading="lazy" />
          <div class="wl-item-info">
            <div class="wl-item-name">${item.title}</div>
            <div class="wl-item-price">&#165;${Number(item.price).toLocaleString()}</div>
          </div>
          <button class="wl-item-remove" data-id="${item.id}" aria-label="Remove">&#215;</button>
        </div>
      `).join('');
      body.querySelectorAll('.wl-item-remove').forEach(btn => {
        btn.addEventListener('click', () => {
          saveWL(getWL().filter(i => i.id !== btn.dataset.id));
          renderWLBody(); renderWLCount(); syncWLButtons();
        });
      });
    }

    function syncWLButtons() {
      const ids = new Set(getWL().map(i => i.id));
      document.querySelectorAll('.wl-btn').forEach(btn => {
        const saved = ids.has(btn.dataset.id);
        btn.classList.toggle('saved', saved);
        btn.textContent = saved ? '♥' : '♡';
      });
    }

    function openDrawer() {
      renderWLBody();
      document.getElementById('wl-drawer')?.classList.add('open');
      document.getElementById('wl-overlay')?.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeDrawer() {
      document.getElementById('wl-drawer')?.classList.remove('open');
      document.getElementById('wl-overlay')?.classList.remove('open');
      document.body.style.overflow = '';
    }

    document.getElementById('wl-open-btn')?.addEventListener('click', openDrawer);
    document.getElementById('wl-close-btn')?.addEventListener('click', closeDrawer);
    document.getElementById('wl-overlay')?.addEventListener('click', closeDrawer);
    document.getElementById('wl-clear-btn')?.addEventListener('click', () => {
      saveWL([]); renderWLBody(); renderWLCount(); syncWLButtons();
    });

    document.querySelectorAll('.wl-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const { id, title, price, img } = btn.dataset;
        let list = getWL();
        const exists = list.some(i => i.id === id);
        saveWL(exists ? list.filter(i => i.id !== id) : [...list, { id, title, price, img }]);
        renderWLCount(); syncWLButtons();
      });
    });

    renderWLCount(); syncWLButtons();

    // ── メール登録 ──
    document.getElementById('email-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = document.getElementById('email-input')?.value?.trim();
      if (!email) return;
      try {
        const subs = JSON.parse(localStorage.getItem('jdh-subscribers') || '[]');
        if (!subs.includes(email)) { subs.push(email); localStorage.setItem('jdh-subscribers', JSON.stringify(subs)); }
      } catch {}
      const form = document.getElementById('email-form');
      const success = document.getElementById('email-success');
      if (form) form.style.display = 'none';
      if (success) success.style.display = 'block';
    });
  </script>

</body>
</html>
