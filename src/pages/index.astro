---
const products = [
  {
    id: 'item-01',
    title: 'テスト用おすすめガジェット',
    price: 5000,
    imageUrl: 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500',
    amazonUrl: 'https://www.amazon.co.jp/',
    category: 'Daily Goods',
  },
  {
    id: 'product-1',
    title: 'KURA - Minimalist Waxed Canvas Backpack',
    price: 38500,
    imageUrl: 'https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=500',
    amazonUrl: 'https://www.amazon.co.jp/dp/EXAMPLE123',
    category: 'Fashion',
  },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Japan Daily Hub | Authentic Japanese Products</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@300;400&family=Cormorant+Garamond:wght@300;400&display=swap" rel="stylesheet" />
  <style>
    :root {
      --ink: #12100e;
      --gold: #b8963e;
      --gold-l: #d4af5a;
      --washi: #f6f1e9;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--washi);
      color: var(--ink);
      font-family: 'Noto Serif JP', serif;
    }

    /* TICKER */
    .ticker {
      background: var(--ink);
      color: rgba(255,255,255,.6);
      font-size: .6rem;
      letter-spacing: .18em;
      padding: .4rem 1.5rem;
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .ticker-lbl { color: var(--gold); }
    .ticker-rate { color: #fff; }
    .ticker-save { color: #4ade80; margin-left: auto; }

    /* HEADER */
    header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(246,241,233,.95);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(184,150,62,.25);
    }
    .header-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .logo {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.3rem;
      font-weight: 300;
      letter-spacing: .22em;
      text-transform: uppercase;
      color: var(--ink);
    }
    .logo em { color: var(--gold); font-style: normal; }
    .lang-select {
      background: transparent;
      border: 1px solid rgba(184,150,62,.35);
      color: var(--ink);
      padding: .35rem .7rem;
      font-size: .72rem;
      font-family: inherit;
      cursor: pointer;
      border-radius: 2px;
      outline: none;
      letter-spacing: .05em;
    }
    .lang-select:hover { border-color: var(--gold); }

    /* HERO */
    .hero {
      background: var(--ink);
      color: #fff;
      text-align: center;
      padding: 6rem 1.5rem 5rem;
      position: relative;
      overflow: hidden;
    }
    .hero-bg {
      position: absolute; inset: 0;
      background: url('https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?w=1600&q=60') center/cover no-repeat;
      opacity: .15;
    }
    .hero-inner { position: relative; z-index: 1; }
    .hero-eye {
      font-size: .68rem;
      letter-spacing: .5em;
      color: var(--gold-l);
      text-transform: uppercase;
      margin-bottom: 1rem;
    }
    .hero-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(2rem, 5vw, 4rem);
      font-weight: 300;
      letter-spacing: .12em;
      line-height: 1.3;
    }
    .hero-line {
      width: 44px; height: 1px;
      background: var(--gold);
      margin: 1.8rem auto;
    }
    .hero-desc {
      font-size: .82rem;
      line-height: 2;
      color: rgba(255,255,255,.55);
      letter-spacing: .08em;
    }

    /* YEN SECTION */
    .yen-section {
      background: #1a1510;
      color: #fff;
      padding: 4rem 1.5rem;
      text-align: center;
    }
    .yen-eye {
      font-size: .65rem;
      letter-spacing: .45em;
      color: var(--gold-l);
      text-transform: uppercase;
      margin-bottom: .8rem;
    }
    .yen-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(1.6rem, 3.5vw, 2.8rem);
      font-weight: 300;
      letter-spacing: .1em;
      margin-bottom: 2rem;
    }
    .rate-cards {
      display: flex;
      justify-content: center;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 2.5rem;
    }
    .rate-card {
      border: 1px solid rgba(184,150,62,.25);
      border-radius: 4px;
      padding: 1.2rem 1.5rem;
      min-width: 130px;
      text-align: center;
    }
    .rate-flag { font-size: 1.6rem; margin-bottom: .3rem; }
    .rate-cur { font-size: .6rem; letter-spacing: .3em; color: rgba(255,255,255,.4); margin-bottom: .4rem; }
    .rate-val {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.7rem;
      color: #fff;
    }
    .rate-badge {
      font-size: .62rem;
      color: var(--gold-l);
      margin-top: .4rem;
      letter-spacing: .06em;
    }
    .calc-box {
      max-width: 520px;
      margin: 0 auto;
      border: 1px solid rgba(184,150,62,.25);
      border-radius: 4px;
      padding: 1.8rem;
      text-align: left;
    }
    .calc-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.2rem;
      font-weight: 300;
      letter-spacing: .1em;
      margin-bottom: 1rem;
    }
    .calc-row { display: flex; gap: .75rem; margin-bottom: 1.2rem; flex-wrap: wrap; }
    .calc-input {
      flex: 1;
      min-width: 120px;
      background: rgba(255,255,255,.06);
      border: 1px solid rgba(184,150,62,.3);
      color: #fff;
      padding: .6rem .8rem;
      font-size: .9rem;
      font-family: 'Cormorant Garamond', serif;
      outline: none;
      border-radius: 2px;
    }
    .calc-select {
      background: rgba(255,255,255,.06);
      border: 1px solid rgba(184,150,62,.3);
      color: #fff;
      padding: .6rem .8rem;
      font-size: .85rem;
      outline: none;
      cursor: pointer;
      border-radius: 2px;
    }
    .calc-result {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .calc-col { flex: 1; min-width: 100px; }
    .calc-col-lbl { font-size: .58rem; letter-spacing: .2em; color: rgba(255,255,255,.35); text-transform: uppercase; margin-bottom: .3rem; }
    .calc-now { font-family: 'Cormorant Garamond', serif; font-size: 1.5rem; }
    .calc-was { font-family: 'Cormorant Garamond', serif; font-size: 1.3rem; color: rgba(255,255,255,.35); text-decoration: line-through; }
    .calc-save { font-family: 'Cormorant Garamond', serif; font-size: 1.8rem; color: #4ade80; }
    .calc-save-pct { font-size: .7rem; color: rgba(74,222,128,.7); letter-spacing: .1em; }

    /* TABS */
    .tab-nav {
      background: rgba(246,241,233,.98);
      border-bottom: 1px solid rgba(184,150,62,.2);
      position: sticky;
      top: 64px;
      z-index: 90;
    }
    .tab-list {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
      display: flex;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .tab-list::-webkit-scrollbar { display: none; }
    .tab-btn {
      flex-shrink: 0;
      padding: .85rem 1.5rem;
      font-size: .72rem;
      letter-spacing: .2em;
      color: rgba(18,16,14,.45);
      border: none;
      background: none;
      cursor: pointer;
      border-bottom: 2px solid transparent;
      transition: color .2s, border-color .2s;
      font-family: inherit;
      white-space: nowrap;
    }
    .tab-btn:hover { color: var(--ink); }
    .tab-btn.active { color: var(--gold); border-bottom-color: var(--gold); }

    /* PRODUCTS */
    .section-wrap {
      max-width: 1200px;
      margin: 0 auto;
      padding: 4rem 1.5rem 5rem;
    }
    .section-head {
      display: flex;
      align-items: center;
      gap: 1.2rem;
      margin-bottom: 2.5rem;
    }
    .section-lbl {
      font-size: .68rem;
      letter-spacing: .45em;
      color: var(--gold);
      text-transform: uppercase;
      white-space: nowrap;
    }
    .section-rule {
      flex: 1;
      height: 1px;
      background: linear-gradient(to right, rgba(184,150,62,.4), transparent);
    }
    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 1.8rem;
    }
    .product-card {
      background: #fff;
      border: 1px solid rgba(184,150,62,.12);
      display: flex;
      flex-direction: column;
      transition: box-shadow .3s, transform .3s;
    }
    .product-card:hover {
      box-shadow: 0 16px 48px rgba(18,16,14,.1);
      transform: translateY(-4px);
    }
    .product-img-wrap {
      aspect-ratio: 4/3;
      overflow: hidden;
      background: #f0ece4;
      display: block;
      text-decoration: none;
    }
    .product-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      padding: 1rem;
      transition: transform .5s ease;
    }
    .product-card:hover .product-img-wrap img { transform: scale(1.05); }
    .product-body {
      padding: 1.3rem;
      display: flex;
      flex-direction: column;
      flex: 1;
    }
    .product-cat {
      font-size: .58rem;
      letter-spacing: .35em;
      color: var(--gold);
      text-transform: uppercase;
      margin-bottom: .5rem;
    }
    .product-name {
      font-size: .85rem;
      line-height: 1.8;
      color: var(--ink);
      flex: 1;
      margin-bottom: .8rem;
      text-decoration: none;
    }
    .yen-badge {
      font-size: .58rem;
      padding: .2rem .6rem;
      background: rgba(74,222,128,.1);
      color: #16a34a;
      border: 1px solid rgba(74,222,128,.3);
      display: inline-block;
      margin-bottom: .8rem;
      letter-spacing: .06em;
    }
    .product-price {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.55rem;
      color: var(--ink);
      margin-bottom: 1rem;
    }
    .product-price small { font-size: .85rem; color: rgba(18,16,14,.5); }
    .btn-buy {
      display: block;
      text-align: center;
      padding: .8rem;
      background: var(--ink);
      color: #fff;
      text-decoration: none;
      font-size: .62rem;
      letter-spacing: .38em;
      text-transform: uppercase;
      transition: background .22s;
    }
    .btn-buy:hover { background: var(--gold); }

    /* PANEL */
    .tab-panel { display: none; }
    .tab-panel.active { display: block; }

    /* FOOTER */
    footer {
      border-top: 1px solid rgba(184,150,62,.18);
      padding: 2.2rem 1.5rem;
      text-align: center;
      font-size: .62rem;
      letter-spacing: .35em;
      color: rgba(18,16,14,.3);
      text-transform: uppercase;
    }
  </style>
</head>
<body>

  <!-- FOREX TICKER -->
  <div class="ticker">
    <span class="ticker-lbl">LIVE RATE</span>
    <span>USD <span class="ticker-rate" id="t-usd">…</span></span>
    <span>EUR <span class="ticker-rate" id="t-eur">…</span></span>
    <span>GBP <span class="ticker-rate" id="t-gbp">…</span></span>
    <span>AUD <span class="ticker-rate" id="t-aud">…</span></span>
    <span class="ticker-save" id="t-save">↓ weak yen = you save</span>
  </div>

  <!-- HEADER -->
  <header>
    <div class="header-inner">
      <div class="logo">Japan<em>Daily</em> Hub</div>
        <select class="lang-select" id="lang-select">
        <option value="en">🌐 English</option>
        <option value="ja">🇯🇵 日本語</option>
        <option value="zh">🇨🇳 简体中文</option>
        <option value="zhtw">🇹🇼 繁體中文</option>
        <option value="ko">🇰🇷 한국어</option>
        <option value="fr">🇫🇷 Français</option>
        <option value="de">🇩🇪 Deutsch</option>
        <option value="es">🇪🇸 Español</option>
      </select>
    </div>
  </header>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-inner">
      <p class="hero-eye"
        data-en="Curated from Japan" data-ja="日本から厳選"
        data-zh="日本精选" data-zhtw="日本精選"
        data-ko="일본에서 엄선" data-fr="Sélectionné du Japon"
        data-de="Kuratiert aus Japan" data-es="Seleccionado de Japón">Curated from Japan</p>
      <h1 class="hero-title"
        data-en="Japanese Beauty,<br/>Into Your Life"
        data-ja="日本の美しさを、<br/>あなたの暮らしへ"
        data-zh="日本之美，<br/>融入您的生活"
        data-zhtw="日本之美，<br/>融入您的生活"
        data-ko="일본의 아름다움을<br/>당신의 삶으로"
        data-fr="La Beauté Japonaise,<br/>Dans Votre Vie"
        data-de="Japanische Schönheit<br/>in Ihrem Leben"
        data-es="La Belleza Japonesa,<br/>en Tu Vida">
        Japanese Beauty,<br/>Into Your Life
      </h1>
      <div class="hero-line"></div>
      <p class="hero-desc"
        data-en="Handpicked Japanese products — where tradition meets craftsmanship."
        data-ja="伝統と職人技が交差する日本の逸品を厳選。"
        data-zh="精选日本商品——传统与工艺的完美融合。"
        data-zhtw="精選日本商品——傳統與工藝的完美融合。"
        data-ko="전통과 장인정신이 만나는 일본 상품을 엄선했습니다."
        data-fr="Des produits japonais soigneusement sélectionnés — où la tradition rencontre le savoir-faire."
        data-de="Handverlesene japanische Produkte — wo Tradition auf Handwerkskunst trifft."
        data-es="Productos japoneses seleccionados — donde la tradición se encuentra con la artesanía.">
        Handpicked Japanese products — where tradition meets craftsmanship.
      </p>
    </div>
  </section>

  <!-- YEN ADVANTAGE -->
  <section class="yen-section">
    <p class="yen-eye"
      data-en="Why buy from Japan now?" data-ja="今、日本から買うべき理由"
      data-zh="为什么现在要从日本购买？" data-zhtw="為什麼現在要從日本購買？"
      data-ko="지금 일본에서 구매해야 하는 이유" data-fr="Pourquoi acheter du Japon maintenant ?"
      data-de="Warum jetzt aus Japan kaufen?" data-es="¿Por qué comprar de Japón ahora?">Why buy from Japan now?</p>
    <h2 class="yen-title"
      data-en="The Weak Yen Advantage" data-ja="円安で得するチャンス"
      data-zh="日元贬值带来的优势" data-zhtw="日圓貶值帶來的優勢"
      data-ko="엔화 약세의 이점" data-fr="L'Avantage du Yen Faible"
      data-de="Der Vorteil des schwachen Yen" data-es="La Ventaja del Yen Débil">The Weak Yen Advantage</h2>
    <div class="rate-cards">
      <div class="rate-card"><div class="rate-flag">🇺🇸</div><div class="rate-cur">USD</div><div class="rate-val" id="r-usd">…</div><div class="rate-badge" id="b-usd"></div></div>
      <div class="rate-card"><div class="rate-flag">🇪🇺</div><div class="rate-cur">EUR</div><div class="rate-val" id="r-eur">…</div><div class="rate-badge" id="b-eur"></div></div>
      <div class="rate-card"><div class="rate-flag">🇬🇧</div><div class="rate-cur">GBP</div><div class="rate-val" id="r-gbp">…</div><div class="rate-badge" id="b-gbp"></div></div>
      <div class="rate-card"><div class="rate-flag">🇦🇺</div><div class="rate-cur">AUD</div><div class="rate-val" id="r-aud">…</div><div class="rate-badge" id="b-aud"></div></div>
    </div>
    <div class="calc-box">
      <div class="calc-title"
        data-en="Savings Calculator" data-ja="節約額シミュレーター"
        data-zh="节省金额计算器" data-zhtw="節省金額計算器"
        data-ko="절약 계산기" data-fr="Calculateur d'Économies"
        data-de="Sparrechner" data-es="Calculadora de Ahorros">Savings Calculator</div>
      <div class="calc-row">
        <input class="calc-input" id="calc-price" type="number" value="10000" min="100" step="100" />
        <select class="calc-select" id="calc-cur">
          <option value="USD">USD $</option>
          <option value="EUR">EUR €</option>
          <option value="GBP">GBP £</option>
          <option value="AUD">AUD A$</option>
        </select>
      </div>
      <div class="calc-result">
        <div class="calc-col"><div class="calc-col-lbl"
          data-en="You pay now" data-ja="現在の支払額"
          data-zh="现在您支付" data-zhtw="現在您支付"
          data-ko="지금 지불 금액" data-fr="Vous payez maintenant"
          data-de="Sie zahlen jetzt" data-es="Usted paga ahora">You pay now</div><div class="calc-now" id="c-now">—</div></div>
        <div style="color:rgba(255,255,255,.2)">→</div>
        <div class="calc-col"><div class="calc-col-lbl"
          data-en="Was in 2021" data-ja="2021年なら"
          data-zh="2021年的价格" data-zhtw="2021年的價格"
          data-ko="2021년 가격" data-fr="C'était en 2021"
          data-de="War 2021" data-es="Era en 2021">Was in 2021</div><div class="calc-was" id="c-was">—</div></div>
        <div class="calc-col" style="text-align:center"><div class="calc-col-lbl"
          data-en="You save" data-ja="節約額"
          data-zh="您节省" data-zhtw="您節省"
          data-ko="절약 금액" data-fr="Vous économisez"
          data-de="Sie sparen" data-es="Usted ahorra">You save</div><div class="calc-save" id="c-save">—</div><div class="calc-save-pct" id="c-pct"></div></div>
      </div>
    </div>
  </section>

  <!-- TABS -->
  <nav class="tab-nav">
    <div class="tab-list">
      <button class="tab-btn active" data-tab="all"
        data-en="All Products" data-ja="すべて"
        data-zh="全部商品" data-zhtw="全部商品"
        data-ko="전체 상품" data-fr="Tous les Produits"
        data-de="Alle Produkte" data-es="Todos los Productos">All Products</button>
      <button class="tab-btn" data-tab="food"
        data-en="Food &amp; Drink" data-ja="飲食・食品"
        data-zh="食品饮料" data-zhtw="食品飲料"
        data-ko="식품·음료" data-fr="Alimentation"
        data-de="Essen &amp; Trinken" data-es="Comida y Bebida">Food &amp; Drink</button>
      <button class="tab-btn" data-tab="daily"
        data-en="Daily Goods" data-ja="日用雑貨"
        data-zh="日用品" data-zhtw="日用品"
        data-ko="생활용품" data-fr="Articles Quotidiens"
        data-de="Alltagswaren" data-es="Artículos Diarios">Daily Goods</button>
      <button class="tab-btn" data-tab="fashion"
        data-en="Fashion" data-ja="衣料品"
        data-zh="时尚" data-zhtw="時尚"
        data-ko="패션" data-fr="Mode"
        data-de="Mode" data-es="Moda">Fashion</button>
    </div>
  </nav>

  <!-- PANEL: ALL -->
  <div class="tab-panel active" id="panel-all">
    <div class="section-wrap">
      <div class="section-head">
        <span class="section-lbl"
          data-en="All Products" data-ja="すべての商品"
          data-zh="全部商品" data-zhtw="全部商品"
          data-ko="전체 상품" data-fr="Tous les Produits"
          data-de="Alle Produkte" data-es="Todos los Productos">All Products</span>
        <span class="section-rule"></span>
      </div>
      <div class="product-grid">
        {products.map(p => (
          <article class="product-card">
            <a class="product-img-wrap" href={`/japandaily-hub/products/${p.id}`}>
              <img src={p.imageUrl} alt={p.title} loading="lazy" />
            </a>
            <div class="product-body">
              <div class="product-cat">{p.category}</div>
              <div class="product-name">{p.title}</div>
              <div class="yen-badge"
                data-en="↓ ~25% cheaper due to weak yen" data-ja="↓ 円安で約25%お得"
                data-zh="↓ 因日元贬值便宜约25%" data-zhtw="↓ 因日圓貶值便宜約25%"
                data-ko="↓ 엔화 약세로 약 25% 저렴" data-fr="↓ ~25% moins cher grâce au yen faible"
                data-de="↓ ~25% günstiger durch schwachen Yen" data-es="↓ ~25% más barato por el yen débil">↓ ~25% cheaper due to weak yen</div>
              <div class="product-price"><small>¥</small>{p.price.toLocaleString()}</div>
              <a class="btn-buy" href={p.amazonUrl} target="_blank" rel="noopener"
                data-en="Buy on Amazon" data-ja="Amazonで購入"
                data-zh="在亚马逊购买" data-zhtw="在亞馬遜購買"
                data-ko="아마존에서 구매" data-fr="Acheter sur Amazon"
