---
const base = import.meta.env.BASE_URL ?? '';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>About Us | Japan Daily Hub</title>
  <meta name="description" content="Japan Daily Hub is an independent curation site helping global shoppers discover authentic Japanese products at weak-yen prices. Learn our story and get in touch." />
  <link rel="canonical" href="https://japandaily-hub.github.io/japandaily-hub/about/" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@300;400&family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&display=swap" rel="stylesheet" />
  <style>
    :root { --ink:#12100e; --gold:#b8963e; --gold-l:#d4af5a; --washi:#f6f1e9; }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--washi); color: var(--ink); font-family: 'Noto Serif JP','Hiragino Mincho ProN', serif; }

    /* ── HEADER ── */
    header {
      position: sticky; top: 0; z-index: 100;
      background: rgba(246,241,233,.95);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(184,150,62,.25);
    }
    .header-inner {
      max-width: 1200px; margin: 0 auto;
      padding: 0 1.5rem; height: 64px;
      display: flex; align-items: center; justify-content: space-between;
    }
    .site-name {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.3rem; font-weight: 300;
      letter-spacing: .22em; text-transform: uppercase;
      color: var(--ink); text-decoration: none;
    }
    .site-name em { color: var(--gold); font-style: normal; }
    nav { display: flex; gap: 2rem; align-items: center; }
    nav a {
      font-size: .65rem; letter-spacing: .25em; text-transform: uppercase;
      color: rgba(18,16,14,.5); text-decoration: none;
      transition: color .2s;
    }
    nav a:hover, nav a.active { color: var(--gold); }

    /* ── HERO ── */
    .page-hero {
      background: var(--ink); color: #fff;
      padding: 5rem 1.5rem 4rem; text-align: center;
      position: relative; overflow: hidden;
    }
    .page-hero::before {
      content: '';
      position: absolute; inset: 0;
      background: url('https://images.unsplash.com/photo-1528360983277-13d401cdc186?w=1600&q=50') center/cover;
      opacity: .08;
    }
    .page-hero-inner { position: relative; z-index: 1; }
    .page-eye {
      font-size: .65rem; letter-spacing: .5em;
      color: var(--gold-l); text-transform: uppercase; margin-bottom: 1rem;
    }
    .page-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(2rem, 5vw, 3.5rem);
      font-weight: 300; letter-spacing: .12em; line-height: 1.3;
    }
    .page-rule { width: 44px; height: 1px; background: var(--gold); margin: 1.8rem auto; }

    /* ── CONTENT ── */
    .content-wrap {
      max-width: 780px; margin: 0 auto;
      padding: 5rem 1.5rem 6rem;
    }

    /* ── SECTION ── */
    .section { margin-bottom: 4rem; }
    .section-label {
      font-size: .6rem; letter-spacing: .45em; text-transform: uppercase;
      color: var(--gold); margin-bottom: 1.2rem;
    }
    .section-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(1.5rem, 3vw, 2rem);
      font-weight: 300; letter-spacing: .08em;
      line-height: 1.4; margin-bottom: 1.5rem;
    }
    .section-body {
      font-size: .88rem; line-height: 2.2;
      letter-spacing: .04em; color: rgba(18,16,14,.75);
    }
    .section-body p + p { margin-top: 1.2rem; }
    .divider {
      height: 1px; background: rgba(184,150,62,.2);
      margin: 4rem 0;
    }

    /* ── VALUES GRID ── */
    .values-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 1.5rem; margin-top: 2rem;
    }
    .value-card {
      border: 1px solid rgba(184,150,62,.2);
      padding: 1.5rem 1.2rem;
    }
    .value-icon { font-size: 1.5rem; margin-bottom: .8rem; }
    .value-title {
      font-size: .7rem; letter-spacing: .25em; text-transform: uppercase;
      color: var(--gold); margin-bottom: .6rem;
    }
    .value-body { font-size: .8rem; line-height: 1.8; color: rgba(18,16,14,.6); }

    /* ── DISCLOSURE BOX ── */
    .disclosure-box {
      border: 1px solid rgba(184,150,62,.3);
      background: rgba(184,150,62,.04);
      padding: 1.5rem 1.8rem;
      margin-top: 1.5rem;
    }
    .disclosure-box p {
      font-size: .78rem; line-height: 1.9;
      color: rgba(18,16,14,.6); letter-spacing: .03em;
    }
    .disclosure-box strong { color: var(--ink); }

    /* ── CONTACT FORM ── */
    .contact-wrap {
      background: #fff;
      border: 1px solid rgba(184,150,62,.15);
      padding: 2.5rem;
      margin-top: 2rem;
    }
    .form-group { margin-bottom: 1.4rem; }
    .form-label {
      display: block; font-size: .6rem; letter-spacing: .3em;
      text-transform: uppercase; color: rgba(18,16,14,.45);
      margin-bottom: .5rem;
    }
    .form-input, .form-textarea {
      width: 100%; padding: .75rem 1rem;
      border: 1px solid rgba(184,150,62,.3);
      background: var(--washi); color: var(--ink);
      font-size: .85rem; font-family: inherit;
      outline: none; border-radius: 0;
      transition: border-color .2s;
    }
    .form-input:focus, .form-textarea:focus { border-color: var(--gold); }
    .form-textarea { resize: vertical; min-height: 140px; }
    .btn-submit {
      display: inline-block; padding: 1rem 2.5rem;
      background: var(--ink); color: #fff; border: none;
      font-size: .65rem; letter-spacing: .4em; text-transform: uppercase;
      cursor: pointer; font-family: inherit;
      transition: background .22s;
    }
    .btn-submit:hover { background: var(--gold); }
    .contact-direct {
      margin-top: 1.5rem; font-size: .78rem;
      color: rgba(18,16,14,.45); letter-spacing: .05em;
    }
    .contact-direct a { color: var(--gold); text-decoration: none; }
    .contact-direct a:hover { text-decoration: underline; }
    .form-success {
      display: none; padding: 1rem 1.2rem;
      background: rgba(74,222,128,.08);
      border: 1px solid rgba(74,222,128,.3);
      color: #16a34a; font-size: .82rem;
      letter-spacing: .05em; margin-top: 1rem;
    }

    /* ── FOOTER ── */
    footer {
      border-top: 1px solid rgba(184,150,62,.18);
      padding: 2rem 1.5rem; text-align: center;
      font-size: .62rem; letter-spacing: .3em;
      color: rgba(18,16,14,.3); text-transform: uppercase;
    }
    footer a { color: rgba(18,16,14,.4); text-decoration: none; }
    footer a:hover { color: var(--gold); }
  </style>
</head>
<body>

  <header>
    <div class="header-inner">
      <a href={`${base}/`} class="site-name">Japan<em>Daily</em> Hub</a>
      <nav>
        <a href={`${base}/`}>Shop</a>
        <a href={`${base}/about/`} class="active">About</a>
      </nav>
    </div>
  </header>

  <!-- HERO -->
  <div class="page-hero">
    <div class="page-hero-inner">
      <p class="page-eye">Our Story</p>
      <h1 class="page-title">About Japan Daily Hub</h1>
      <div class="page-rule"></div>
    </div>
  </div>

  <div class="content-wrap">

    <!-- MISSION -->
    <section class="section">
      <p class="section-label">Mission</p>
      <h2 class="section-title">We believe the weak yen is a once-in-a-generation opportunity — and most people don't know it yet.</h2>
      <div class="section-body">
        <p>Japan Daily Hub was created to bridge that gap. Since 2021, the Japanese yen has depreciated significantly against the US Dollar, Euro, and British Pound — making authentic Japanese products cheaper for overseas buyers than they've been in over two decades.</p>
        <p>We hand-pick products across stationery, kitchen, beauty, electronics, food, and fashion — then show you exactly how much you're saving compared to 2021 prices, in real time. No guesswork, no vague discounts. Just honest math and exceptional products.</p>
        <p>Everything on this site links to Amazon Japan, one of the world's most trusted e-commerce platforms, which ships internationally to over 100 countries with buyer protections in place.</p>
      </div>
    </section>

    <div class="divider"></div>

    <!-- VALUES -->
    <section class="section">
      <p class="section-label">What We Stand For</p>
      <div class="values-grid">
        <div class="value-card">
          <div class="value-icon">🇯🇵</div>
          <div class="value-title">Authenticity</div>
          <div class="value-body">Every product is genuinely made in or sourced from Japan. No knockoffs, no grey-market listings.</div>
        </div>
        <div class="value-card">
          <div class="value-icon">📊</div>
          <div class="value-title">Transparency</div>
          <div class="value-body">Live exchange rates. Real savings calculations. We show our math, always.</div>
        </div>
        <div class="value-card">
          <div class="value-icon">🔗</div>
          <div class="value-title">Independence</div>
          <div class="value-body">We are not paid by brands to feature products. Our curation is based solely on quality and value.</div>
        </div>
        <div class="value-card">
          <div class="value-icon">🌏</div>
          <div class="value-title">Accessibility</div>
          <div class="value-body">Available in 8 languages. Because great Japanese products should be discoverable by everyone.</div>
        </div>
      </div>
    </section>

    <div class="divider"></div>

    <!-- AFFILIATE DISCLOSURE -->
    <section class="section">
      <p class="section-label">Affiliate Disclosure</p>
      <h2 class="section-title">How We Make Money</h2>
      <div class="section-body">
        <p>Japan Daily Hub participates in the Amazon Associates Program and other affiliate advertising programs. This means we earn a small commission when you click through to Amazon and make a purchase — at <strong>no additional cost to you whatsoever</strong>. The price you pay on Amazon is exactly the same whether you clicked from our site or typed the URL directly.</p>
      </div>
      <div class="disclosure-box">
        <p><strong>Full Disclosure:</strong> Japan Daily Hub is a participant in the Amazon Services LLC Associates Program, an affiliate advertising program designed to provide a means for sites to earn advertising fees by advertising and linking to amazon.co.jp. As an Amazon Associate, we earn from qualifying purchases. All product recommendations are our own independent editorial choices.</p>
      </div>
    </section>

    <div class="divider"></div>

    <!-- CONTACT -->
    <section class="section">
      <p class="section-label">Get In Touch</p>
      <h2 class="section-title">Contact Us</h2>
      <div class="section-body">
        <p>Questions about a product? A suggestion for what to add next? A partnership inquiry? We read every message and respond within 2 business days.</p>
      </div>

      <div class="contact-wrap">
        <form
          id="contact-form"
          action="https://formspree.io/f/xdkodwrw"
          method="POST"
        >
          <div class="form-group">
            <label class="form-label" for="contact-name">Your Name</label>
            <input class="form-input" id="contact-name" type="text" name="name" required placeholder="Jane Smith" />
          </div>
          <div class="form-group">
            <label class="form-label" for="contact-email">Email Address</label>
            <input class="form-input" id="contact-email" type="email" name="email" required placeholder="jane@example.com" />
          </div>
          <div class="form-group">
            <label class="form-label" for="contact-subject">Subject</label>
            <input class="form-input" id="contact-subject" type="text" name="subject" placeholder="Product suggestion / Question / Partnership" />
          </div>
          <div class="form-group">
            <label class="form-label" for="contact-message">Message</label>
            <textarea class="form-textarea" id="contact-message" name="message" required placeholder="Tell us what's on your mind..."></textarea>
          </div>
          <button class="btn-submit" type="submit">Send Message</button>
        </form>

        <div class="form-success" id="form-success">
          ✓ Message sent! We'll get back to you within 2 business days.
        </div>

        <p class="contact-direct">
          Prefer email? Reach us directly at
          <a href="mailto:hello@japandailyhub.com">hello@japandailyhub.com</a>
        </p>
      </div>
    </section>

  </div>

  <footer>
    &copy; 2025 Japan Daily Hub &nbsp;·&nbsp;
    <a href={`${base}/`}>Shop</a> &nbsp;·&nbsp;
    <a href={`${base}/about/`}>About</a> &nbsp;·&nbsp;
    Authentic Japanese Products, Delivered Worldwide
  </footer>

  <script is:inline>
    const form = document.getElementById('contact-form');
    const success = document.getElementById('form-success');
    if (form) {
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        const data = new FormData(form);
        try {
          const res = await fetch(form.action, {
            method: 'POST',
            body: data,
            headers: { 'Accept': 'application/json' }
          });
          if (res.ok) {
            form.style.display = 'none';
            if (success) success.style.display = 'block';
          } else {
            alert('Something went wrong. Please email us directly at hello@japandailyhub.com');
          }
        } catch(err) {
          alert('Something went wrong. Please email us directly at hello@japandailyhub.com');
        }
      });
    }
  </script>

</body>
</html>
