---
import { getCollection } from 'astro:content';
import { categories } from '../../data/categories.ts';

export async function getStaticPaths() {
  const allProducts = await getCollection('products');
  return categories.map(cat => {
    const products = allProducts.filter(p => {
      const catField = (p.data.category ?? '').toLowerCase();
      const tabField = (p.data.tab ?? '').toLowerCase();
      return cat.matches.some(m => {
        const ml = m.toLowerCase();
        return catField === ml || tabField === ml;
      });
    });
    return { params: { slug: cat.slug }, props: { cat, products } };
  });
}

const { cat, products } = Astro.props;
const base = import.meta.env.BASE_URL ?? '';
const hasProducts = products.length > 0;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{cat.nameJa} — Japan Daily Hub</title>
  <meta name="description" content={`${cat.descEn} — Authentic Japanese ${cat.nameEn} at weak-yen prices. Ships worldwide.`} />
  <meta property="og:title" content={`${cat.nameJa} | Japan Daily Hub`} />
  <meta property="og:description" content={`${cat.descEn} — Save up to 28% vs 2021 prices thanks to the weak yen.`} />
  <meta property="og:image" content="https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?w=1200&q=80" />
  <meta property="og:url" content={`https://japandaily-hub.github.io${base}/category/${cat.slug}/`} />
  <link rel="canonical" href={`https://japandaily-hub.github.io${base}/category/${cat.slug}/`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@300;400&family=Cormorant+Garamond:wght@300;400&display=swap" rel="stylesheet" />
  <style>
    :root { --ink: #12100e; --gold: #b8963e; --gold-l: #d4af5a; --washi: #f6f1e9; }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--washi); color: var(--ink); font-family: 'Noto Serif JP', serif; }

    header {
      position: sticky; top: 0; z-index: 100;
      background: rgba(246,241,233,.95); backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(184,150,62,.25);
    }
    .header-inner {
      max-width: 1200px; margin: 0 auto; padding: 0 1.5rem;
      height: 64px; display: flex; align-items: center; justify-content: space-between;
    }
    .logo {
      font-family: 'Cormorant Garamond', serif; font-size: 1.3rem;
      font-weight: 300; letter-spacing: .22em; text-transform: uppercase; color: var(--ink);
      text-decoration: none;
    }
    .logo em { color: var(--gold); font-style: normal; }
    .nav-links { display: flex; gap: 1.5rem; align-items: center; }
    .nav-link {
      font-size: .62rem; letter-spacing: .22em; text-transform: uppercase;
      color: rgba(18,16,14,.45); text-decoration: none; transition: color .2s;
    }
    .nav-link:hover { color: var(--gold); }
    .back-btn {
      font-size: .62rem; letter-spacing: .2em; text-transform: uppercase;
      color: rgba(18,16,14,.45); text-decoration: none;
      border: 1px solid rgba(184,150,62,.3); padding: .35rem .8rem;
      border-radius: 2px; transition: all .2s;
    }
    .back-btn:hover { border-color: var(--gold); color: var(--gold); }

    /* HERO */
    .cat-hero {
      background: var(--ink); color: #fff;
      padding: 5rem 1.5rem 4rem; text-align: center;
      position: relative; overflow: hidden;
    }
    .cat-hero-bg {
      position: absolute; inset: 0;
      background: url('https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?w=1600&q=60') center/cover no-repeat;
      opacity: .1;
    }
    .cat-hero-inner { position: relative; z-index: 1; }
    .cat-icon-lg { font-size: 3.5rem; margin-bottom: 1rem; display: block; }
    .cat-eye {
      font-size: .65rem; letter-spacing: .45em; color: var(--gold-l);
      text-transform: uppercase; margin-bottom: .6rem;
    }
    .cat-h1 {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 300;
      letter-spacing: .12em; line-height: 1.3; margin-bottom: 1rem;
    }
    .cat-desc-txt {
      font-size: .82rem; color: rgba(255,255,255,.5);
      letter-spacing: .06em; line-height: 1.9;
    }
    .cat-line { width: 44px; height: 1px; background: var(--gold); margin: 1.5rem auto; }

    /* BREADCRUMB */
    .breadcrumb {
      max-width: 1200px; margin: 0 auto; padding: 1.2rem 1.5rem;
      font-size: .62rem; letter-spacing: .12em; color: rgba(18,16,14,.35);
    }
    .breadcrumb a { color: rgba(18,16,14,.35); text-decoration: none; }
    .breadcrumb a:hover { color: var(--gold); }

    /* CATEGORY NAV */
    .cat-nav {
      background: rgba(246,241,233,.98);
      border-bottom: 1px solid rgba(184,150,62,.15);
    }
    .cat-nav-inner {
      max-width: 1200px; margin: 0 auto; padding: 0 1.5rem;
      display: flex; overflow-x: auto; scrollbar-width: none; gap: .2rem;
    }
    .cat-nav-inner::-webkit-scrollbar { display: none; }
    .cat-nav-link {
      flex-shrink: 0; padding: .75rem 1.2rem;
      font-size: .65rem; letter-spacing: .18em; text-transform: uppercase;
      color: rgba(18,16,14,.4); text-decoration: none;
      border-bottom: 2px solid transparent;
      transition: color .2s, border-color .2s; white-space: nowrap;
    }
    .cat-nav-link:hover { color: var(--ink); }
    .cat-nav-link.active { color: var(--gold); border-bottom-color: var(--gold); }

    /* PRODUCT GRID */
    .section-wrap {
      max-width: 1200px; margin: 0 auto; padding: 4rem 1.5rem 5rem;
    }
    .section-head {
      display: flex; align-items: center; gap: 1.2rem; margin-bottom: 2.5rem;
    }
    .section-lbl {
      font-size: .68rem; letter-spacing: .45em; color: var(--gold);
      text-transform: uppercase; white-space: nowrap;
    }
    .section-rule {
      flex: 1; height: 1px;
      background: linear-gradient(to right, rgba(184,150,62,.4), transparent);
    }
    .product-count {
      font-size: .62rem; color: rgba(18,16,14,.3); letter-spacing: .1em;
    }
    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 1.8rem;
    }
    .product-card {
      background: #fff; border: 1px solid rgba(184,150,62,.12);
      display: flex; flex-direction: column;
      transition: box-shadow .3s, transform .3s;
    }
    .product-card:hover {
      box-shadow: 0 16px 48px rgba(18,16,14,.1); transform: translateY(-4px);
    }
    .product-img-wrap {
      aspect-ratio: 4/3; overflow: hidden; background: #f0ece4;
      display: block; text-decoration: none;
    }
    .product-img-wrap img {
      width: 100%; height: 100%; object-fit: contain; padding: 1rem;
      transition: transform .5s ease;
    }
    .product-card:hover .product-img-wrap img { transform: scale(1.05); }
    .product-body { padding: 1.3rem; display: flex; flex-direction: column; flex: 1; }
    .product-cat {
      font-size: .58rem; letter-spacing: .35em; color: var(--gold);
      text-transform: uppercase; margin-bottom: .5rem;
    }
    .product-name {
      font-size: .85rem; line-height: 1.8; color: var(--ink); flex: 1;
      margin-bottom: .8rem; text-decoration: none;
      display: block;
    }
    .product-price {
      font-family: 'Cormorant Garamond', serif; font-size: 1.55rem;
      color: var(--ink); margin-bottom: 1rem;
    }
    .product-price small { font-size: .85rem; color: rgba(18,16,14,.5); }
    .btn-buy {
      display: block; text-align: center; padding: .8rem;
      background: var(--ink); color: #fff; text-decoration: none;
      font-size: .62rem; letter-spacing: .38em; text-transform: uppercase;
      transition: background .22s;
    }
    .btn-buy:hover { background: var(--gold); }

    /* EMPTY STATE */
    .empty-state {
      text-align: center; padding: 6rem 1.5rem;
      color: rgba(18,16,14,.3);
    }
    .empty-icon { font-size: 3rem; margin-bottom: 1.5rem; display: block; }
    .empty-title {
      font-family: 'Cormorant Garamond', serif; font-size: 1.8rem;
      font-weight: 300; letter-spacing: .1em; margin-bottom: .8rem;
      color: rgba(18,16,14,.5);
    }
    .empty-desc { font-size: .8rem; letter-spacing: .06em; line-height: 1.9; }
    .btn-back {
      display: inline-block; margin-top: 2rem; padding: .75rem 2rem;
      background: var(--ink); color: #fff; text-decoration: none;
      font-size: .62rem; letter-spacing: .3em; text-transform: uppercase;
      transition: background .2s;
    }
    .btn-back:hover { background: var(--gold); }

    footer {
      border-top: 1px solid rgba(184,150,62,.18); padding: 2.2rem 1.5rem;
      text-align: center; font-size: .62rem; letter-spacing: .35em;
      color: rgba(18,16,14,.3); text-transform: uppercase;
    }
  </style>
</head>
<body>

  <header>
    <div class="header-inner">
      <a href={`${base}/`} class="logo">Japan<em>Daily</em> Hub</a>
      <div class="nav-links">
        <a href={`${base}/`} class="nav-link">Home</a>
        <a href={`${base}/about/`} class="nav-link">About</a>
        <a href={`${base}/`} class="back-btn">← All Categories</a>
      </div>
    </div>
  </header>

  <!-- CATEGORY HERO -->
  <section class="cat-hero">
    <div class="cat-hero-bg"></div>
    <div class="cat-hero-inner">
      <span class="cat-icon-lg">{cat.icon}</span>
      <p class="cat-eye">{cat.nameEn}</p>
      <h1 class="cat-h1">{cat.nameJa}</h1>
      <div class="cat-line"></div>
      <p class="cat-desc-txt">{cat.descEn} — weak yen means you save more.</p>
    </div>
  </section>

  <!-- CATEGORY NAV BAR -->
  <nav class="cat-nav" aria-label="Categories">
    <div class="cat-nav-inner">
      {categories.map(c => (
        <a
          href={`${base}/category/${c.slug}/`}
          class={`cat-nav-link${c.slug === cat.slug ? ' active' : ''}`}
        >
          {c.icon} {c.nameJa}
        </a>
      ))}
    </div>
  </nav>

  <!-- BREADCRUMB -->
  <div class="breadcrumb">
    <a href={`${base}/`}>Home</a> › {cat.nameJa}
  </div>

  <!-- PRODUCT GRID -->
  <div class="section-wrap">
    {hasProducts ? (
      <>
        <div class="section-head">
          <span class="section-lbl">{cat.nameJa}</span>
          <div class="section-rule"></div>
          <span class="product-count">{products.length} items</span>
        </div>
        <div class="product-grid">
          {products.map(p => (
            <div class="product-card">
              <a href={`${base}/products/${p.slug}/`} class="product-img-wrap">
                <img
                  src={p.data.imageUrl ?? 'https://images.unsplash.com/photo-1528360983277-13d401cdc186?w=500&q=60'}
                  alt={p.data.title}
                  loading="lazy"
                />
              </a>
              <div class="product-body">
                <span class="product-cat">{cat.nameEn}</span>
                <a href={`${base}/products/${p.slug}/`} class="product-name">
                  {p.data.title}
                </a>
                <div class="product-price">
                  ¥{p.data.price.toLocaleString()}<small> JPY</small>
                </div>
                <a
                  href={p.data.amazonUrl ?? p.data.amazon_url ?? '#'}
                  class="btn-buy"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Buy on Amazon →
                </a>
              </div>
            </div>
          ))}
        </div>
      </>
    ) : (
      <div class="empty-state">
        <span class="empty-icon">{cat.icon}</span>
        <p class="empty-title">Coming Soon</p>
        <p class="empty-desc">
          We're curating the best {cat.nameEn.toLowerCase()} from Japan.<br />
          Sign up below to get notified when new items arrive.
        </p>
        <a href={`${base}/#email-form`} class="btn-back">Get Notified</a>
      </div>
    )}
  </div>

  <footer>
    &copy; 2025 Japan Daily Hub &nbsp;|&nbsp; Authentic Japanese Products, Delivered Worldwide
  </footer>

</body>
</html>
