---
interface Props {
  /** SVG path d attribute — viewBox 0 0 48 48 */
  path: string;
  /** Display size in rem (default 2.2) */
  size?: number;
  class?: string;
}
const { path, size = 2.2, class: className = '' } = Astro.props;
---
<svg
  viewBox="0 0 48 48"
  width={`${size}rem`}
  height={`${size}rem`}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={`cat-svg-icon${className ? ' ' + className : ''}`}
  aria-hidden="true"
>
  <path d={path} />
</svg>
