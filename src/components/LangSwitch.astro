---
// LangSwitch — EN / JA toggle
---
<button id="lang-toggle" aria-label="Toggle language" style="
  font-size:.62rem; letter-spacing:.2em; text-transform:uppercase;
  background:transparent; border:1px solid rgba(184,150,62,.35);
  padding:.3rem .85rem; cursor:pointer; color:inherit; font-family:inherit;
  transition:border-color .2s, color .2s;
">EN / JA</button>

<script is:inline>
(function() {
  var LANGS = ['en','ja'];
  function applyLang(lang) {
    if (!LANGS.includes(lang)) lang = 'en';
    document.querySelectorAll('[data-en]').forEach(function(el) {
      var t = el.dataset[lang] || el.dataset.en;
      if (t) el.innerHTML = t;
    });
    var btn = document.getElementById('lang-toggle');
    if (btn) btn.textContent = lang === 'en' ? 'EN / JA' : 'JA / EN';
    try { localStorage.setItem('jdh-lang', lang); } catch(e) {}
  }

  var savedLang = 'en';
  try { savedLang = localStorage.getItem('jdh-lang') || 'en'; } catch(e) {}

  document.addEventListener('DOMContentLoaded', function() {
    applyLang(savedLang);
    var btn = document.getElementById('lang-toggle');
    if (btn) {
      btn.addEventListener('click', function() {
        try { savedLang = localStorage.getItem('jdh-lang') || 'en'; } catch(e) { savedLang = 'en'; }
        applyLang(savedLang === 'en' ? 'ja' : 'en');
      });
    }
  });
})();
</script>
