---
// ForexTicker — live USD/GBP/EUR rates from free API
---
<div id="forex-ticker" style="
  background:#12100e; color:rgba(255,255,255,.5);
  font-size:.58rem; letter-spacing:.22em; text-align:center;
  padding:.32rem 1rem; white-space:nowrap; overflow:hidden;
">
  ¥ &nbsp;·&nbsp; Loading rates…
</div>

<script is:inline>
(function() {
  var APIS = [
    'https://open.er-api.com/v6/latest/JPY',
    'https://api.exchangerate-api.com/v4/latest/JPY',
    'https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest/v1/currencies/jpy.json',
  ];

  function setTicker(text) {
    var el = document.getElementById('forex-ticker');
    if (el) el.textContent = text;
  }

  async function loadRates() {
    try {
      var cached = JSON.parse(sessionStorage.getItem('jdh-rates') || 'null');
      if (cached && Date.now() - cached.ts < 600000) {
        showRates(cached);
        return;
      }
    } catch(e) {}

    for (var i = 0; i < APIS.length; i++) {
      try {
        var res = await fetch(APIS[i], { signal: AbortSignal.timeout(3500) });
        if (!res.ok) continue;
        var data = await res.json();
        var usd = data.rates && data.rates.USD ? data.rates.USD : (data.jpy && data.jpy.usd ? data.jpy.usd : null);
        var gbp = data.rates && data.rates.GBP ? data.rates.GBP : (data.jpy && data.jpy.gbp ? data.jpy.gbp : null);
        var eur = data.rates && data.rates.EUR ? data.rates.EUR : (data.jpy && data.jpy.eur ? data.jpy.eur : null);
        if (!usd) continue;
        var r = { usd: 1/usd, gbp: gbp ? 1/gbp : 0, eur: eur ? 1/eur : 0, ts: Date.now() };
        try { sessionStorage.setItem('jdh-rates', JSON.stringify(r)); } catch(e) {}
        showRates(r);
        return;
      } catch(e) {}
    }
    setTicker('¥1 JPY  ·  ≈ $0.0064 USD  ·  ≈ £0.0050 GBP  ·  ≈ €0.0059 EUR');
  }

  function showRates(r) {
    setTicker(
      '¥1 JPY' +
      '  ·  ≈ $' + r.usd.toFixed(4) + ' USD' +
      (r.gbp ? '  ·  ≈ £' + r.gbp.toFixed(4) + ' GBP' : '') +
      (r.eur ? '  ·  ≈ €' + r.eur.toFixed(4) + ' EUR' : '') +
      '  ·  Weak yen = you save up to 28% vs 2021'
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadRates);
  } else {
    loadRates();
  }
})();
</script>
