# ── Mailchimp ──────────────────────────────────────────────
# Mailchimp → Account → Extras → API keys
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us1

# Mailchimp → Audience → Settings → Audience name and defaults → Audience ID
MAILCHIMP_LIST_ID=xxxxxxxxxx

# ── Amazon PA-API（sync.js で使用） ────────────────────────
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=

# ── Google Gemini（sync.js で使用） ────────────────────────
GEMINI_API_KEY=

# ── SNS（sns.js で使用） ────────────────────────────────────
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
